<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\TrustCabinet.Domain\TrustCabinet.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Parses the minutes' HTML so MinutesHtml can keep only its allow-list (ADR-0055). 1.5.0+ fixes GHSA-pgww-w46g-26qg. -->
    <PackageReference Include="AngleSharp" Version="1.8.5" />
    <!-- S3 API client for the file store: Cloudflare R2, SeaweedFS in development (ADR-0024). -->
    <PackageReference Include="AWSSDK.S3" Version="4.0.100.2" />
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageReference Include="Google.Apis.Auth" Version="1.76.0" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <!-- Pin MailKit's transitive dependency to the security-patched runtime package. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="Livekit.Server.Sdk.Dotnet" Version="1.2.3" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.12" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- The minutes as PDF (SCRUM-32), drawn on the server without LibreOffice. Community license: a public, non-commercial
         student project (MinutesPdf sets it). -->
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
    <PackageReference Include="StackExchange.Redis" Version="3.3.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Liberation Serif 2.1.5 (SIL OFL 1.1, Summaries/Fonts/LICENSE): metric-compatible with Times New Roman and covers
         Vietnamese. The runtime image has no Times New Roman, so the PDF minutes carry their own font. -->
    <EmbeddedResource Include="Summaries\Fonts\*.ttf" LogicalName="TrustCabinet.Fonts.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- GoogleTokenVerifier.IdentityFrom is internal: the rules it holds (email must be verified,
         subject must be present) need testing, but nothing outside this assembly should call it.
         Google's library allows no signing key to be substituted, so the wrapper around it cannot
         be unit-tested and these rules would otherwise be covered by nothing. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>TrustCabinet.Web.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
