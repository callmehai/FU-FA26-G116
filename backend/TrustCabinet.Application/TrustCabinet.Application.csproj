<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TrustCabinet.Domain\TrustCabinet.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The only three packages a use case may lean on (rule R1 of docs/02-design/11-quy-chuan-clean-architecture.md).
         ArchitectureTests fails when a fourth appears: EF Core, Npgsql, ASP.NET Core and every SDK stay in Infrastructure. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- Services keep the access level they had in Infrastructure (rule R4), so an internal one stays testable. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>TrustCabinet.Web.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>TrustCabinet.Application.Tests</_Parameter1>
    </AssemblyAttribute>
    <!-- TrustCabinetDbContext writes the audit row of a meeting history entry with AuditService.DetailsOptions, the
         same encoder as AuditService, so that internal member stays internal and readable there. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>TrustCabinet.Infrastructure</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
