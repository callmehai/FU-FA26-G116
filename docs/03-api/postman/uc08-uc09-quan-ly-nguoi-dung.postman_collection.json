  "item": [
    {
      "name": "00 · Admin đăng nhập",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{demoPassword}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('adminToken', pm.response.json().accessToken);",
              "pm.collectionVariables.set('adminId', pm.response.json().user.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "01 · Thành viên đăng nhập (để thử 403)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{memberEmail}}\",\n  \"password\": \"{{demoPassword}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('memberToken', pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 · Lấy danh sách vai trò",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/roles"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "",
              "const roles = pm.response.json();",
              "const byName = n => roles.find(r => r.name === n);",
              "pm.collectionVariables.set('memberRoleId', byName('Thành viên').id);",
              "pm.collectionVariables.set('secretaryRoleId', byName('Thư ký').id);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 · Tạo tài khoản thử (chỉ lần chạy đầu tiên)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/users",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Người Thử UC08\",\n  \"email\": \"{{tempEmail}}\",\n  \"password\": \"{{tempPassword}}\",\n  \"roleId\": \"{{memberRoleId}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const auth = { Authorization: 'Bearer ' + pm.collectionVariables.get('adminToken') };",
              "pm.sendRequest({ url: pm.collectionVariables.get('baseUrl') + '/api/users', header: auth }, (err, res) => {",
              "    const existing = res.json().find(u => u.email === pm.collectionVariables.get('tempEmail'));",
              "    pm.collectionVariables.set('tempActive', existing ? String(existing.isActive) : 'true');",
              "    if (existing) {",
              "        pm.collectionVariables.set('tempId', existing.id);",
              "        pm.execution.skipRequest();",
              "    }",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.test('code = MSG07', () => pm.expect(pm.response.json().code).to.eql('MSG07'));",
              "pm.collectionVariables.set('tempId', pm.response.json().user.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 · Kích hoạt lại tài khoản thử (lần chạy trước đã khoá nó)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/users/{{tempId}}/status",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"isActive\": true\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.collectionVariables.get('tempActive') === 'true') { pm.execution.skipRequest(); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('code = MSG11', () => pm.expect(pm.response.json().code).to.eql('MSG11'));"
            ]
          }
        }
      ]
    },
