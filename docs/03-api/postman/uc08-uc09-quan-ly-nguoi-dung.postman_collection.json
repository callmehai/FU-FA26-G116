          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.sendRequest({ url: pm.collectionVariables.get('mailpitUrl') + '/api/v1/messages', method: 'DELETE' }, () => {});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('code = MSG13', () => pm.expect(pm.response.json().code).to.eql('MSG13'));",
              "",
              "const base = pm.collectionVariables.get('mailpitUrl');",
              "const to = pm.collectionVariables.get('tempEmail');",
              "pm.sendRequest(base + '/api/v1/search?query=' + encodeURIComponent('to:' + to), (err, res) => {",
              "    pm.test('Mailpit received the reset email', () => {",
              "        pm.expect(err).to.eql(null);",
              "        pm.expect(res.json().messages.length).to.be.above(0);",
              "    });",
              "    const id = res.json().messages[0].ID;",
              "    pm.sendRequest(base + '/api/v1/message/' + id, (err2, msg) => {",
              "        const text = msg.json().Text;",
              "        const match = /reset-password#token=([A-Za-z0-9_-]+)/.exec(text);",
              "        pm.test('the email carries the link with the token in the fragment', () => pm.expect(match).to.not.eql(null));",
              "        pm.collectionVariables.set('deactivatedToken', match[1]);",
              "    });",
              "});"
            ]
          }
        }
      ]
