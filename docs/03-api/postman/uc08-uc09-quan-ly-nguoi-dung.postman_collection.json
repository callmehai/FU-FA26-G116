    {
      "name": "44 · UC-09 EX-2 · Hạ vai trò quản trị viên cuối cùng → MSG12",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/users/{{adminId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"{{adminName}}\",\n  \"email\": \"{{adminEmail}}\",\n  \"roleId\": \"{{memberRoleId}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Only meaningful while the signed-in admin is the sole active account holding AdminUsers (through",
              "// any role) — otherwise this request would really demote them. The server counts by capability, so",
              "// this check does too: it reads which roles carry AdminUsers, then counts active users in them.",
              "const base = pm.collectionVariables.get('baseUrl');",
              "const auth = { Authorization: 'Bearer ' + pm.collectionVariables.get('adminToken') };",
              "pm.sendRequest({ url: base + '/api/roles/capabilities', header: auth }, (err, matrix) => {",
              "    const adminRoles = matrix.json().roles",
              "        .filter(r => r.capabilities.includes('AdminUsers'))",
              "        .map(r => r.id);",
              "    pm.sendRequest({ url: base + '/api/users', header: auth }, (err2, res) => {",
              "        const me = res.json().find(u => u.id === pm.collectionVariables.get('adminId'));",
              "        pm.collectionVariables.set('adminName', me.fullName);",
              "        const admins = res.json().filter(u => u.isActive && adminRoles.includes(u.roleId));",
              "        if (admins.length !== 1 || admins[0].id !== me.id) { pm.execution.skipRequest(); }",
              "    });",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 409', () => pm.response.to.have.status(409));",
              "pm.test('code = MSG12', () => pm.expect(pm.response.json().code).to.eql('MSG12'));"
            ]
          }
        }
      ]
    },
