    },
    {
      "key": "adminEmail",
      "value": "quantri@trustcabinet.local"
    },
    {
      "key": "memberEmail",
      "value": "thanhvien@trustcabinet.local"
    },
    {
      "key": "demoPassword",
      "value": "TrustCabinet@2026"
    },
    {
      "key": "tempEmail",
      "value": "uc08-postman@trustcabinet.local"
    },
    {
      "key": "tempPassword",
      "value": "MatKhauBanDau@2026"
    },
    {
      "key": "newPassword",
