{
  "info": {
    "name": "TrustCabinet SCRUM-20 Backend",
    "description": "Chỉ dùng database test. Chọn token đúng actor; chạy Context để lấy ETag trước mỗi mutation. Stale revision: 409/MSG238; query hoặc If-Match sai/thiếu: 400/MSG239. Không dùng MSG156/MSG157 của tài liệu cho Participants. Xem docs/03-api/09-thanh-phan-tham-du-ban-giao.md. Không lưu credentials trong export.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5225",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "meetingId",
      "value": "20000000-0000-7000-8000-000000000005",
      "type": "string"
    },
    {
      "key": "etag",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "participantId",
      "value": "",
      "type": "string"
    },
    {
      "key": "guestInvitationId",
      "value": "",
      "type": "string"
    },
    {
      "key": "outgoingChairId",
      "value": "",
      "type": "string"
    },
    {
      "key": "incomingChairId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 Context (lưu ETag)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/meetings/{{meetingId}}/participant-context"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const tag = pm.response.headers.get('ETag');",
              "if (tag && pm.response.code < 300) pm.collectionVariables.set('etag', tag);",
              "pm.test('Không lỗi server', () => pm.expect(pm.response.code).to.be.below(500));"
            ]
          }
        }
      ]
    },
