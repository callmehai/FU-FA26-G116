    {
      "name": "GET snapshot / capture order",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/meetings/{{meetingId}}/agenda",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{secretaryToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);",
              "const s = pm.response.json();",
              "pm.collectionVariables.set('orderVersion', s.orderVersion);",
              "pm.collectionVariables.set('orderedItemIds', JSON.stringify(s.items.map(i => i.id).reverse()));"
            ]
          }
        }
      ]
    },
    {
      "name": "GET editor options",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/meetings/{{meetingId}}/agenda/editor-options",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{secretaryToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);",
              "const o = pm.response.json();",
              "if(o.presenters.length) pm.collectionVariables.set('presenterId', o.presenters[0].id);",
              "const d = o.documents.find(d => !d.agendaItemId); if(d) pm.collectionVariables.set('documentId', d.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Create item / capture ID",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/meetings/{{meetingId}}/agenda",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{secretaryToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Báo cáo thử nghiệm\",\n  \"description\": \"Nội dung\\nThảo luận\",\n  \"presenterId\": null,\n  \"documentIds\": [],\n  \"presenterGuestInvitationId\": null\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(201);",
              "pm.expect(pm.response.json().code).to.eql('MSG60');",
              "pm.collectionVariables.set('itemId', pm.response.json().agendaItemId);"
            ]
          }
        }
      ]
    },
