  <diagram id="uc06c_deactivatereactivateuseraccount" name="UC-06c - Deactivate / Reactivate User Account">
    <mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject id="mermaid-uc06c_deactivatereactivateuseraccount" label="" mermaidData="{&amp;quot;data&amp;quot;: &amp;quot;%%{init: {\&amp;quot;sequence\&amp;quot;: {\&amp;quot;mirrorActors\&amp;quot;: false}}}%%
sequenceDiagram
actor Admin as \&amp;quot;System Admin\&amp;quot;
participant UserPage@{ \&amp;quot;type\&amp;quot;: \&amp;quot;boundary\&amp;quot; } as \&amp;quot;User Management Page\&amp;quot;
participant UserController@{ \&amp;quot;type\&amp;quot;: \&amp;quot;control\&amp;quot; } as \&amp;quot;:User Controller\&amp;quot;
participant UserService@{ \&amp;quot;type\&amp;quot;: \&amp;quot;control\&amp;quot; } as \&amp;quot;:User Service\&amp;quot;
participant UserRepository as \&amp;quot;:User Repository\&amp;quot;
participant SessionService@{ \&amp;quot;type\&amp;quot;: \&amp;quot;control\&amp;quot; } as \&amp;quot;:Session Service\&amp;quot;
participant AuditService@{ \&amp;quot;type\&amp;quot;: \&amp;quot;control\&amp;quot; } as \&amp;quot;:Audit Service\&amp;quot;
participant Database@{ \&amp;quot;type\&amp;quot;: \&amp;quot;database\&amp;quot; } as \&amp;quot;:Database\&amp;quot;
Admin-&amp;gt;&amp;gt;UserPage: Select user account and status action
activate UserPage
UserPage-&amp;gt;&amp;gt;UserController: Change user account status
activate UserController
UserController-&amp;gt;&amp;gt;UserService: Change user account status
activate UserService
UserService-&amp;gt;&amp;gt;UserRepository: Get current account status
activate UserRepository
UserRepository-&amp;gt;&amp;gt;Database: Retrieve user account
activate Database
Database--&amp;gt;&amp;gt;UserRepository: User account information
UserRepository--&amp;gt;&amp;gt;UserService: Current account status
alt Status change is not allowed
UserService--&amp;gt;&amp;gt;UserController: Status change not allowed
UserController--&amp;gt;&amp;gt;UserPage: Display reason for rejected status change
UserPage--&amp;gt;&amp;gt;Admin: Show status change error
else Status change is allowed
alt Deactivate Account
UserService-&amp;gt;&amp;gt;UserRepository: Set account status to Inactive
UserRepository-&amp;gt;&amp;gt;Database: Update account status
Database--&amp;gt;&amp;gt;UserRepository: Account status updated
UserRepository--&amp;gt;&amp;gt;UserService: Account deactivated
UserService-&amp;gt;&amp;gt;SessionService: End active sessions
activate SessionService
SessionService--&amp;gt;&amp;gt;UserService: Active sessions ended
UserService-&amp;gt;&amp;gt;AuditService: Record account deactivation
activate AuditService
AuditService-&amp;gt;&amp;gt;Database: Store audit record
Database--&amp;gt;&amp;gt;AuditService: Audit record created
AuditService--&amp;gt;&amp;gt;UserService: Deactivation recorded
UserService--&amp;gt;&amp;gt;UserController: Account deactivated successfully
UserController--&amp;gt;&amp;gt;UserPage: MSG11 - User account status changed successfully
UserPage--&amp;gt;&amp;gt;Admin: Display Inactive status
deactivate AuditService
deactivate SessionService
else Reactivate Account
UserService-&amp;gt;&amp;gt;UserRepository: Set account status to Active
UserRepository-&amp;gt;&amp;gt;Database: Update account status
Database--&amp;gt;&amp;gt;UserRepository: Account status updated
UserRepository--&amp;gt;&amp;gt;UserService: Account reactivated
UserService-&amp;gt;&amp;gt;AuditService: Record account reactivation
activate AuditService
AuditService-&amp;gt;&amp;gt;Database: Store audit record
Database--&amp;gt;&amp;gt;AuditService: Audit record created
AuditService--&amp;gt;&amp;gt;UserService: Reactivation recorded
UserService--&amp;gt;&amp;gt;UserController: Account reactivated successfully
UserController--&amp;gt;&amp;gt;UserPage: MSG11 - User account status changed successfully
UserPage--&amp;gt;&amp;gt;Admin: Display Active status
deactivate AuditService
end
end
deactivate Database
deactivate UserRepository
deactivate UserService
deactivate UserController
deactivate UserPage
&amp;quot;, &amp;quot;config&amp;quot;: null}">
