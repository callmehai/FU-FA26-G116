  <diagram id="uc31_recordattendance" name="UC-31 - Record Attendance">
    <mxGraphModel dx="4832" dy="2724" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&quot;data&quot;: &quot;%%{init: {\&quot;sequence\&quot;: {\&quot;mirrorActors\&quot;: false}}}%%\nsequenceDiagram\nactor User as \&quot;Secretary\&quot;\nparticipant MeetingPage@{ \&quot;type\&quot;: \&quot;boundary\&quot; } as \&quot;Meeting Management Page\&quot;\nparticipant ParticipantController@{ \&quot;type\&quot;: \&quot;control\&quot; } as \&quot;:Meeting Participant Controller\&quot;\nparticipant ParticipantService@{ \&quot;type\&quot;: \&quot;control\&quot; } as \&quot;:Meeting Participant Service\&quot;\nparticipant ParticipantRepository as \&quot;:Meeting Participant Repository\&quot;\nparticipant Database@{ \&quot;type\&quot;: \&quot;database\&quot; } as \&quot;:Database\&quot;\nUser-&gt;&gt;MeetingPage: Submit Present/Absent changes for selected internal participants or Guests\nactivate MeetingPage\nMeetingPage-&gt;&gt;ParticipantController: Submit Present/Absent changes for selected internal participants or Guests\nactivate ParticipantController\nParticipantController-&gt;&gt;ParticipantService: recordMeetingAttendance(meeting, secretary, submittedEntries, attendanceChanges)\nactivate ParticipantService\nParticipantService-&gt;&gt;ParticipantRepository: Read Meeting status, current internal and Guest roster,&lt;br/&gt;actor relationship, roles and additional permissions\nactivate ParticipantRepository\nParticipantRepository-&gt;&gt;Database: Retrieve current Meeting and roster information\nactivate Database\nDatabase--&gt;&gt;ParticipantRepository: Current information / Read failure\ndeactivate Database\nParticipantRepository--&gt;&gt;ParticipantService: Current information / Read failure\ndeactivate ParticipantRepository\nParticipantService-&gt;&gt;ParticipantService: Require active assigned Secretary and InProgress Meeting (BR-170)\nParticipantService-&gt;&gt;ParticipantService: Validate official Present/Absent choices for submitted current entries only; omitted entries retain saved/unmarked state;&lt;br/&gt;never infer attendance from invitation responses or room connections (BR-116, BR-171, BR-172)\nalt Secretary is no longer authorized - EX-2\nParticipantService--&gt;&gt;ParticipantController: Request denied; previous attendance unchanged\nParticipantController--&gt;&gt;MeetingPage: Request denied; previous attendance unchanged\nMeetingPage--&gt;&gt;User: Request denied; previous attendance unchanged\nelse Meeting is no longer InProgress - EX-2\nParticipantService--&gt;&gt;ParticipantController: MSG149 - Attendance can only be recorded while the meeting is in progress.\nParticipantController--&gt;&gt;MeetingPage: MSG149 - Attendance can only be recorded while the meeting is in progress.\nMeetingPage--&gt;&gt;User: MSG149 - Attendance can only be recorded while the meeting is in progress.\nelse A submitted internal/Guest entry is stale or no longer current - EX-4\nParticipantService--&gt;&gt;ParticipantController: MSG151 - The meeting participant list has changed. Refresh it and try again.\nParticipantController--&gt;&gt;MeetingPage: MSG151 - The meeting participant list has changed. Refresh it and try again.\nMeetingPage--&gt;&gt;User: MSG151 - The meeting participant list has changed. Refresh it and try again.\nelse At least one submitted entry lacks a valid Present/Absent choice - EX-1\nParticipantService--&gt;&gt;ParticipantController: MSG148 - Select Present or Absent for each submitted participant or Guest.\nParticipantController--&gt;&gt;MeetingPage: MSG148 - Select Present or Absent for each submitted participant or Guest.\nMeetingPage--&gt;&gt;User: MSG148 - Select Present or Absent for each submitted participant or Guest.\nelse Submitted entries are valid; unrelated roster additions do not invalidate the request\nParticipantService-&gt;&gt;ParticipantRepository: Save or revise only submitted internal and Guest attendance values together (AF-1 for revision),&lt;br/&gt;recording the Secretary and save time; no partial changes (BR-172, BR-178)\nactivate ParticipantRepository\nParticipantRepository-&gt;&gt;Database: Save all requested changes together;&lt;br/&gt;recheck Meeting status, authority and submitted entries before saving\nactivate Database\nDatabase--&gt;&gt;ParticipantRepository: Complete save / No changes saved\ndeactivate Database\nParticipantRepository--&gt;&gt;ParticipantService: Complete save / No changes saved\ndeactivate ParticipantRepository\nalt Any attendance save fails - EX-3\nParticipantService--&gt;&gt;ParticipantController: MSG150 - Unable to save attendance. No changes were saved.\nParticipantController--&gt;&gt;MeetingPage: MSG150 - Unable to save attendance. No changes were saved.\nMeetingPage--&gt;&gt;User: MSG150 - Unable to save attendance. No changes were saved.\nelse Submitted changes saved\nParticipantService--&gt;&gt;ParticipantController: MSG147 - Meeting attendance saved successfully.\nParticipantController--&gt;&gt;MeetingPage: MSG147 - Meeting attendance saved successfully.\nMeetingPage--&gt;&gt;User: MSG147 - Meeting attendance saved successfully.\nend\nend\ndeactivate ParticipantService\ndeactivate ParticipantController\ndeactivate MeetingPage\n&quot;, &quot;config&quot;: null}" id="mermaid-uc31_recordattendance">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=20;" vertex="1">
            <mxGeometry height="46" width="3311" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Secretary" mermaidId="n:User" mermaidBaseStyle="html=1;shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;sequenceEdgeStyle&quot;,&quot;libavoidRouting&quot;:0,&quot;curved&quot;:0,&quot;rounded&quot;:0};lifelineDashed=0;strokeWidth=1.25;rounded=1;absoluteArcSize=1;arcSize=6;lifelineColor=light-dark(#9370DB,#cccccc);participant=seqActorStick;verticalAlign=bottom;align=center;spacingBottom=4;size=90;lifelineMirror=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Secretary" id="2">
