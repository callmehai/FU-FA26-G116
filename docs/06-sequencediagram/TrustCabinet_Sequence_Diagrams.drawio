  <diagram id="uc18_submitmeetingforapproval" name="UC-18 - Submit Meeting for Approval">
    <mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject id="mermaid-uc18_submitmeetingforapproval" label="" mermaidData="{&amp;quot;data&amp;quot;: &amp;quot;%%{init: {\&amp;quot;sequence\&amp;quot;: {\&amp;quot;mirrorActors\&amp;quot;: false}}}%%
sequenceDiagram
actor Organizer as \&amp;quot;Meeting Organizer\&amp;quot;
participant MeetingPage@{ \&amp;quot;type\&amp;quot;: \&amp;quot;boundary\&amp;quot; } as \&amp;quot;Meeting Management Page\&amp;quot;
participant MeetingController@{ \&amp;quot;type\&amp;quot;: \&amp;quot;control\&amp;quot; } as \&amp;quot;:Meeting Controller\&amp;quot;
participant MeetingService@{ \&amp;quot;type\&amp;quot;: \&amp;quot;control\&amp;quot; } as \&amp;quot;:Meeting Service\&amp;quot;
participant MeetingRepository as \&amp;quot;:Meeting Repository\&amp;quot;
participant UserRepository as \&amp;quot;:User Repository\&amp;quot;
participant NotificationService as \&amp;quot;:Notification Service\&amp;quot;
participant NotificationRepository as \&amp;quot;:Notification Repository\&amp;quot;
participant Database@{ \&amp;quot;type\&amp;quot;: \&amp;quot;database\&amp;quot; } as \&amp;quot;:Database\&amp;quot;
Organizer-&amp;gt;&amp;gt;MeetingPage: Choose Submit for Approval for a Draft or Rejected meeting
activate MeetingPage
MeetingPage-&amp;gt;&amp;gt;MeetingController: Start meeting submission
activate MeetingController
MeetingController-&amp;gt;&amp;gt;MeetingService: prepareMeetingSubmission(meetingId, organizerId)
activate MeetingService
MeetingService-&amp;gt;&amp;gt;MeetingRepository: Get meeting and current status
activate MeetingRepository
MeetingRepository-&amp;gt;&amp;gt;Database: Retrieve meeting
activate Database
Database--&amp;gt;&amp;gt;MeetingRepository: Meeting and status
deactivate Database
MeetingRepository--&amp;gt;&amp;gt;MeetingService: Meeting and status
deactivate MeetingRepository
MeetingService-&amp;gt;&amp;gt;UserRepository: Verify Organizer is active and has MeetingCreator
activate UserRepository
UserRepository-&amp;gt;&amp;gt;Database: Check Organizer account and capability
activate Database
Database--&amp;gt;&amp;gt;UserRepository: Organizer eligibility
deactivate Database
UserRepository--&amp;gt;&amp;gt;MeetingService: Organizer eligibility
deactivate UserRepository
alt Organizer is inactive or lacks MeetingCreator
MeetingService--&amp;gt;&amp;gt;MeetingController: Submission is not authorized
deactivate MeetingService
MeetingController--&amp;gt;&amp;gt;MeetingPage: Return authorization error
deactivate MeetingController
MeetingPage--&amp;gt;&amp;gt;Organizer: Submission is not authorized
else Organizer is active and authorized
activate MeetingController
activate MeetingService
MeetingService-&amp;gt;&amp;gt;MeetingService: Validate mandatory meeting information including&amp;lt;br/&amp;gt;Planned Start/End Time (BR-33, BR-62); Agenda is not required
alt Meeting-level information is incomplete - EX-1
MeetingService--&amp;gt;&amp;gt;MeetingController: Required meeting information is incomplete
deactivate MeetingService
MeetingController--&amp;gt;&amp;gt;MeetingPage: Return missing information
deactivate MeetingController
MeetingPage--&amp;gt;&amp;gt;Organizer: Required meeting information is incomplete
else Meeting-level information is complete
activate MeetingController
activate MeetingService
MeetingService-&amp;gt;&amp;gt;UserRepository: Find active users with MeetingApprover&amp;lt;br/&amp;gt;excluding the Organizer
activate UserRepository
UserRepository-&amp;gt;&amp;gt;Database: Retrieve eligible Meeting Approvers
activate Database
Database--&amp;gt;&amp;gt;UserRepository: Eligible Meeting Approvers
deactivate Database
UserRepository--&amp;gt;&amp;gt;MeetingService: Eligible Meeting Approvers
deactivate UserRepository
alt No eligible Meeting Approver is available - EX-5
MeetingService--&amp;gt;&amp;gt;MeetingController: MSG140 - No eligible meeting approver is available. Please contact the administrator.
deactivate MeetingService
MeetingController--&amp;gt;&amp;gt;MeetingPage: Return no eligible approver error; existing status, assignment and history unchanged
deactivate MeetingController
MeetingPage--&amp;gt;&amp;gt;Organizer: MSG140 - No eligible meeting approver is available. Please contact the administrator.
else At least one eligible Meeting Approver is available
activate MeetingController
activate MeetingService
MeetingService--&amp;gt;&amp;gt;MeetingController: Eligible Meeting Approvers
deactivate MeetingService
MeetingController--&amp;gt;&amp;gt;MeetingPage: Display eligible Meeting Approvers
deactivate MeetingController
MeetingPage--&amp;gt;&amp;gt;Organizer: Display eligible Meeting Approvers
Organizer-&amp;gt;&amp;gt;MeetingPage: Select a Meeting Approver
MeetingPage-&amp;gt;&amp;gt;MeetingController: Submit selected Meeting Approver
activate MeetingController
MeetingController-&amp;gt;&amp;gt;MeetingService: submitMeetingForApproval(meetingId, approverId, organizerId)
activate MeetingService
MeetingService-&amp;gt;&amp;gt;UserRepository: Revalidate active Organizer and selected approver&amp;lt;br/&amp;gt;(approver has MeetingApprover and differs from Organizer)
activate UserRepository
UserRepository-&amp;gt;&amp;gt;Database: Check Organizer and approver eligibility
activate Database
Database--&amp;gt;&amp;gt;UserRepository: Eligibility results
deactivate Database
UserRepository--&amp;gt;&amp;gt;MeetingService: Eligibility results
deactivate UserRepository
alt Selected approver is no longer eligible - EX-3
MeetingService--&amp;gt;&amp;gt;MeetingController: Selected approver is not eligible
deactivate MeetingService
MeetingController--&amp;gt;&amp;gt;MeetingPage: Return approver validation error
deactivate MeetingController
MeetingPage--&amp;gt;&amp;gt;Organizer: Select another eligible Meeting Approver
else Selected approver is eligible
activate MeetingController
activate MeetingService
MeetingService-&amp;gt;&amp;gt;MeetingRepository: Revalidate meeting status during submission
activate MeetingRepository
MeetingRepository-&amp;gt;&amp;gt;Database: Retrieve current meeting state for update
activate Database
Database--&amp;gt;&amp;gt;MeetingRepository: Current meeting state
deactivate Database
MeetingRepository--&amp;gt;&amp;gt;MeetingService: Current meeting state
deactivate MeetingRepository
alt Meeting is not Draft or Rejected - EX-2
MeetingService--&amp;gt;&amp;gt;MeetingController: MSG41 - This meeting can no longer be submitted for approval
deactivate MeetingService
MeetingController--&amp;gt;&amp;gt;MeetingPage: Return submission restriction
deactivate MeetingController
MeetingPage--&amp;gt;&amp;gt;Organizer: MSG41 - This meeting can no longer be submitted for approval
else Meeting is Draft or Rejected
activate MeetingController
activate MeetingService
MeetingService-&amp;gt;&amp;gt;MeetingRepository: Complete approver assignment, WaitingApproval status&amp;lt;br/&amp;gt;and submission history together (BR-38)
activate MeetingRepository
MeetingRepository-&amp;gt;&amp;gt;Database: Save assignment, status and submission history as one complete action
activate Database
alt Submission cannot be completed - EX-4
Database--&amp;gt;&amp;gt;MeetingRepository: Assignment, status or history could not be completed; previous information unchanged
deactivate Database
MeetingRepository--&amp;gt;&amp;gt;MeetingService: Submission failed
deactivate MeetingRepository
MeetingService--&amp;gt;&amp;gt;MeetingController: MSG42 - Unable to submit the meeting for approval. Please try again
deactivate MeetingService
MeetingController--&amp;gt;&amp;gt;MeetingPage: Return submission failure; no approval notification issued
deactivate MeetingController
MeetingPage--&amp;gt;&amp;gt;Organizer: MSG42 - Unable to submit the meeting for approval. Please try again
else Meeting moved to WaitingApproval
activate Database
activate MeetingController
activate MeetingRepository
activate MeetingService
Database--&amp;gt;&amp;gt;MeetingRepository: Approver assignment, status and submission history recorded together
deactivate Database
MeetingRepository--&amp;gt;&amp;gt;MeetingService: WaitingApproval state
deactivate MeetingRepository
MeetingService-&amp;gt;&amp;gt;NotificationService: Notify assigned Meeting Approver
activate NotificationService
NotificationService-&amp;gt;&amp;gt;NotificationRepository: Create approval notification
activate NotificationRepository
NotificationRepository-&amp;gt;&amp;gt;Database: Save notification
activate Database
Database--&amp;gt;&amp;gt;NotificationRepository: Notification saved
deactivate Database
NotificationRepository--&amp;gt;&amp;gt;NotificationService: Notification created
deactivate NotificationRepository
NotificationService--&amp;gt;&amp;gt;MeetingService: Approver notified
deactivate NotificationService
MeetingService--&amp;gt;&amp;gt;MeetingController: Submission successful
deactivate MeetingService
MeetingController--&amp;gt;&amp;gt;MeetingPage: Submission successful
deactivate MeetingController
MeetingPage--&amp;gt;&amp;gt;Organizer: Meeting submitted for approval
end
end
end
end
end
end
deactivate MeetingPage
