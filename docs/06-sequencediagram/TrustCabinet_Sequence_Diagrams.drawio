  <diagram id="uc16_viewmeetingdetails" name="UC-16 - View Meeting Details">
    <mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject id="mermaid-uc16_viewmeetingdetails" label="" mermaidData="{&quot;data&quot;: &quot;%%{init: {\&quot;sequence\&quot;: {\&quot;mirrorActors\&quot;: false}}}%%\nsequenceDiagram\nactor User as \&quot;Meeting Organizer / Meeting Approver / Chair / Secretary / Participant\&quot;\nparticipant MeetingPage@{ \&quot;type\&quot;: \&quot;boundary\&quot; } as \&quot;Meeting Management Page\&quot;\nparticipant MeetingController@{ \&quot;type\&quot;: \&quot;control\&quot; } as \&quot;:Meeting Controller\&quot;\nparticipant MeetingService@{ \&quot;type\&quot;: \&quot;control\&quot; } as \&quot;:Meeting Service\&quot;\nparticipant MeetingRepository as \&quot;:Meeting Repository\&quot;\nparticipant Database@{ \&quot;type\&quot;: \&quot;database\&quot; } as \&quot;:Database\&quot;\nUser-&gt;&gt;MeetingPage: Request meeting details\nactivate MeetingPage\nMeetingPage-&gt;&gt;MeetingController: View meeting details\nactivate MeetingController\nMeetingController-&gt;&gt;MeetingService: getMeetingDetails(meetingId, userId)\nactivate MeetingService\nMeetingService-&gt;&gt;MeetingRepository: Get accessible meeting (BR-29)\nactivate MeetingRepository\nMeetingRepository-&gt;&gt;Database: Retrieve meeting and verify authorized relationship\nactivate Database\nDatabase--&gt;&gt;MeetingRepository: Accessible meeting / Not found\ndeactivate Database\nMeetingRepository--&gt;&gt;MeetingService: Accessible meeting / Not found\ndeactivate MeetingRepository\nalt Meeting does not exist or is not accessible - EX-1\nMeetingService--&gt;&gt;MeetingController: Not found (same result for both cases)\ndeactivate MeetingService\nMeetingController--&gt;&gt;MeetingPage: Not found\ndeactivate MeetingController\nMeetingPage--&gt;&gt;User: Meeting not found or unavailable\nelse Meeting is accessible\nactivate MeetingController\nactivate MeetingService\nMeetingService-&gt;&gt;MeetingRepository: Get meeting-level details\nactivate MeetingRepository\nMeetingRepository-&gt;&gt;Database: Retrieve meeting-level fields, Planned Start/End Time, Actual Start/End Time&lt;br/&gt;when available and, for a Cancelled Meeting, its cancellation history entry\nactivate Database\nDatabase--&gt;&gt;MeetingRepository: Meeting details / Retrieval failed\ndeactivate Database\nMeetingRepository--&gt;&gt;MeetingService: Meeting details / Retrieval failed\ndeactivate MeetingRepository\nalt Meeting details cannot be retrieved - EX-2\nMeetingService--&gt;&gt;MeetingController: MSG37 - Unable to load meeting details. Please try again.\ndeactivate MeetingService\nMeetingController--&gt;&gt;MeetingPage: Return loading failure\ndeactivate MeetingController\nMeetingPage--&gt;&gt;User: MSG37 - Unable to load meeting details. Please try again.\nelse Meeting details retrieved successfully\nactivate MeetingController\nactivate MeetingService\nMeetingService--&gt;&gt;MeetingController: Meeting Name, Planned Start/End Time, Actual Start/End Time&lt;br/&gt;when available, Mode, Location, Confidentiality Level, Description, Status;&lt;br/&gt;if Cancelled: cancellation reason, who cancelled it and when (BR-298)\ndeactivate MeetingService\nMeetingController--&gt;&gt;MeetingPage: Return meeting information with planned and available actual times\ndeactivate MeetingController\nMeetingPage--&gt;&gt;User: Display meeting-level details and planned/actual times read-only;&lt;br/&gt;for a Cancelled Meeting also show reason, actor and time\nend\nend\ndeactivate MeetingPage&quot;, &quot;config&quot;: null}">
          <mxCell connectable="0" parent="1" vertex="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=20;">
            <mxGeometry x="0" y="0" width="2888.0" height="46.0" as="geometry" />
          </mxCell>
