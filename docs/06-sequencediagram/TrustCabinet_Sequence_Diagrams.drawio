  <diagram id="uc05_viewuseraccount" name="UC-05 - View User Accounts">
    <mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject id="mermaid-uc05_viewuseraccount" label="" mermaidData="{&quot;data&quot;: &quot;%%{init: {\&quot;sequence\&quot;: {\&quot;mirrorActors\&quot;: false}}}%%\nsequenceDiagram\nactor Admin as \&quot;System Admin\&quot;\nparticipant UserPage@{ \&quot;type\&quot;: \&quot;boundary\&quot; } as \&quot;User Management Page\&quot;\nparticipant UserController@{ \&quot;type\&quot;: \&quot;control\&quot; } as \&quot;:User Controller\&quot;\nparticipant UserService@{ \&quot;type\&quot;: \&quot;control\&quot; } as \&quot;:User Service\&quot;\nparticipant UserRepository as \&quot;:User Repository\&quot;\nparticipant Database@{ \&quot;type\&quot;: \&quot;database\&quot; } as \&quot;:Database\&quot;\nAdmin-&gt;&gt;UserPage: Open User Accounts\nactivate UserPage\nUserPage-&gt;&gt;UserController: Request user account list\nactivate UserController\nUserController-&gt;&gt;UserService: Get user accounts\nactivate UserService\nUserService-&gt;&gt;UserRepository: Find user accounts\nactivate UserRepository\nUserRepository-&gt;&gt;Database: Retrieve user accounts\nactivate Database\nDatabase--&gt;&gt;UserRepository: User account data\nUserRepository--&gt;&gt;UserService: User accounts\nUserService--&gt;&gt;UserController: Sorted user account list\nUserController--&gt;&gt;UserPage: User account list\nUserPage--&gt;&gt;Admin: Display user accounts\ndeactivate Database\ndeactivate UserRepository\ndeactivate UserService\ndeactivate UserController\ndeactivate UserPage\n&quot;, &quot;config&quot;: null}">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=20;" vertex="1">
            <mxGeometry x="0" y="0" width="1223.0" height="46.0" as="geometry" />
