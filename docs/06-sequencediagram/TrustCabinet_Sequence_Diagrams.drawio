  <diagram id="uc06a_createuseraccount" name="UC-06a - Create User Account">
    <mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject id="mermaid-uc06a_createuseraccount" label="" mermaidData="{&amp;quot;data&amp;quot;: &amp;quot;%%{init: {\&amp;quot;sequence\&amp;quot;: {\&amp;quot;mirrorActors\&amp;quot;: false}}}%%
sequenceDiagram
actor Admin as \&amp;quot;System Admin\&amp;quot;
participant UserPage@{ \&amp;quot;type\&amp;quot;: \&amp;quot;boundary\&amp;quot; } as \&amp;quot;User Management Page\&amp;quot;
participant UserController@{ \&amp;quot;type\&amp;quot;: \&amp;quot;control\&amp;quot; } as \&amp;quot;:User Controller\&amp;quot;
participant UserService@{ \&amp;quot;type\&amp;quot;: \&amp;quot;control\&amp;quot; } as \&amp;quot;:User Service\&amp;quot;
participant UserRepository as \&amp;quot;:User Repository\&amp;quot;
participant AuditService@{ \&amp;quot;type\&amp;quot;: \&amp;quot;control\&amp;quot; } as \&amp;quot;:Audit Service\&amp;quot;
participant Database@{ \&amp;quot;type\&amp;quot;: \&amp;quot;database\&amp;quot; } as \&amp;quot;:Database\&amp;quot;
Admin-&amp;gt;&amp;gt;UserPage: Submit user information
activate UserPage
UserPage-&amp;gt;&amp;gt;UserController: Create user account
activate UserController
UserController-&amp;gt;&amp;gt;UserService: Create user account
activate UserService
UserService-&amp;gt;&amp;gt;UserRepository: Check Username and Email availability
activate UserRepository
UserRepository-&amp;gt;&amp;gt;Database: Find matching user accounts
activate Database
Database--&amp;gt;&amp;gt;UserRepository: Matching account information
UserRepository--&amp;gt;&amp;gt;UserService: Username and Email availability
alt Invalid user information
UserService--&amp;gt;&amp;gt;UserController: Invalid user information
UserController--&amp;gt;&amp;gt;UserPage: Validation errors
UserPage--&amp;gt;&amp;gt;Admin: Display invalid fields
else Username or Email already exists
UserService--&amp;gt;&amp;gt;UserController: Duplicate account information
UserController--&amp;gt;&amp;gt;UserPage: MSG08 - Username or Email already exists
UserPage--&amp;gt;&amp;gt;Admin: Display duplicate account message
else User information is valid
UserService-&amp;gt;&amp;gt;UserRepository: Create active user account
UserRepository-&amp;gt;&amp;gt;Database: Store user account
Database--&amp;gt;&amp;gt;UserRepository: User account created
UserRepository--&amp;gt;&amp;gt;UserService: Created user account
UserService-&amp;gt;&amp;gt;AuditService: Record user account creation
activate AuditService
AuditService-&amp;gt;&amp;gt;Database: Store audit record
Database--&amp;gt;&amp;gt;AuditService: Audit record created
AuditService--&amp;gt;&amp;gt;UserService: Creation recorded
UserService--&amp;gt;&amp;gt;UserController: User account created successfully
UserController--&amp;gt;&amp;gt;UserPage: MSG07 - User account created successfully
UserPage--&amp;gt;&amp;gt;Admin: Return to User Accounts list
deactivate AuditService
end
deactivate Database
deactivate UserRepository
deactivate UserService
deactivate UserController
deactivate UserPage
&amp;quot;, &amp;quot;config&amp;quot;: null}">
