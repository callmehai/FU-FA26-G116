  <diagram id="uc11_configurerolepermissions" name="UC-11 - Configure Role Permissions">
    <mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject id="mermaid-uc11_configurerolepermissions" label="" mermaidData="{&amp;quot;data&amp;quot;: &amp;quot;%%{init: {\&amp;quot;sequence\&amp;quot;: {\&amp;quot;mirrorActors\&amp;quot;: false}}}%%
sequenceDiagram
actor Admin as \&amp;quot;System Admin\&amp;quot;
participant RolePage@{ \&amp;quot;type\&amp;quot;: \&amp;quot;boundary\&amp;quot; } as \&amp;quot;Role &amp;amp; Permission Management Page\&amp;quot;
participant RoleController@{ \&amp;quot;type\&amp;quot;: \&amp;quot;control\&amp;quot; } as \&amp;quot;:Role Permission Controller\&amp;quot;
participant RoleService@{ \&amp;quot;type\&amp;quot;: \&amp;quot;control\&amp;quot; } as \&amp;quot;:Role Permission Service\&amp;quot;
participant RoleRepository as \&amp;quot;:Role Permission Repository\&amp;quot;
participant AuditService@{ \&amp;quot;type\&amp;quot;: \&amp;quot;control\&amp;quot; } as \&amp;quot;:Audit Service\&amp;quot;
participant Database@{ \&amp;quot;type\&amp;quot;: \&amp;quot;database\&amp;quot; } as \&amp;quot;:Database\&amp;quot;
Admin-&amp;gt;&amp;gt;RolePage: Configure permissions for role
activate RolePage
RolePage-&amp;gt;&amp;gt;RoleController: Submit updated role permissions
activate RoleController
RoleController-&amp;gt;&amp;gt;RoleService: Update role permissions
activate RoleService
RoleService-&amp;gt;&amp;gt;RoleService: Validate permission configuration
alt Invalid permission configuration
RoleService--&amp;gt;&amp;gt;RoleController: Invalid permission configuration
RoleController--&amp;gt;&amp;gt;RolePage: MSG17 - Invalid permission configuration
RolePage--&amp;gt;&amp;gt;Admin: Show validation error
else Valid permission configuration
RoleService-&amp;gt;&amp;gt;RoleRepository: Save updated role permissions
activate RoleRepository
RoleRepository-&amp;gt;&amp;gt;Database: Update role permission configuration
activate Database
alt Permission configuration cannot be saved
Database--&amp;gt;&amp;gt;RoleRepository: Update failed
RoleRepository--&amp;gt;&amp;gt;RoleService: Save failed
RoleService--&amp;gt;&amp;gt;RoleController: Unable to update role permissions
RoleController--&amp;gt;&amp;gt;RolePage: MSG18 - Unable to update role permissions
RolePage--&amp;gt;&amp;gt;Admin: Show update error
else Permission configuration saved
Database--&amp;gt;&amp;gt;RoleRepository: Update successful
RoleRepository--&amp;gt;&amp;gt;RoleService: Role permissions updated
RoleService-&amp;gt;&amp;gt;AuditService: Record role permission change
activate AuditService
AuditService-&amp;gt;&amp;gt;Database: Save audit log
Database--&amp;gt;&amp;gt;AuditService: Audit log saved
AuditService--&amp;gt;&amp;gt;RoleService: Audit recorded
RoleService--&amp;gt;&amp;gt;RoleController: Role permissions updated successfully
RoleController--&amp;gt;&amp;gt;RolePage: MSG16 - Role permissions updated successfully
RolePage--&amp;gt;&amp;gt;Admin: Show success message
deactivate AuditService
end
deactivate Database
deactivate RoleRepository
end
deactivate RoleService
deactivate RoleController
deactivate RolePage
&amp;quot;, &amp;quot;config&amp;quot;: null}">
