  <diagram id="uc19_reviewmeetingapproval" name="UC-19 - Review Meeting Approval">
    <mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject id="mermaid-uc19_reviewmeetingapproval" label="" mermaidData="{&amp;quot;data&amp;quot;: &amp;quot;%%{init: {\&amp;quot;sequence\&amp;quot;: {\&amp;quot;mirrorActors\&amp;quot;: false}}}%%
sequenceDiagram
actor Approver as \&amp;quot;Meeting Approver\&amp;quot;
participant MeetingPage@{ \&amp;quot;type\&amp;quot;: \&amp;quot;boundary\&amp;quot; } as \&amp;quot;Meeting Management Page\&amp;quot;
participant MeetingController@{ \&amp;quot;type\&amp;quot;: \&amp;quot;control\&amp;quot; } as \&amp;quot;:Meeting Controller\&amp;quot;
participant MeetingService@{ \&amp;quot;type\&amp;quot;: \&amp;quot;control\&amp;quot; } as \&amp;quot;:Meeting Service\&amp;quot;
participant MeetingRepository as \&amp;quot;:Meeting Repository\&amp;quot;
participant UserRepository as \&amp;quot;:User Repository\&amp;quot;
participant Database@{ \&amp;quot;type\&amp;quot;: \&amp;quot;database\&amp;quot; } as \&amp;quot;:Database\&amp;quot;
Approver-&amp;gt;&amp;gt;MeetingPage: Submit approval decision
activate MeetingPage
MeetingPage-&amp;gt;&amp;gt;MeetingController: Review meeting approval
activate MeetingController
MeetingController-&amp;gt;&amp;gt;MeetingService: reviewMeetingApproval(meetingId, decision, rejectionReason, actorId)
activate MeetingService
MeetingService-&amp;gt;&amp;gt;MeetingRepository: Get current approval state
activate MeetingRepository
MeetingRepository-&amp;gt;&amp;gt;Database: Retrieve meeting, Organizer, and assigned approver
activate Database
Database--&amp;gt;&amp;gt;MeetingRepository: Current approval state
deactivate Database
MeetingRepository--&amp;gt;&amp;gt;MeetingService: Current approval state
deactivate MeetingRepository
MeetingService-&amp;gt;&amp;gt;UserRepository: Verify actor is active and has MeetingApprover
activate UserRepository
UserRepository-&amp;gt;&amp;gt;Database: Check actor status and capability
activate Database
Database--&amp;gt;&amp;gt;UserRepository: Actor eligibility
deactivate Database
UserRepository--&amp;gt;&amp;gt;MeetingService: Actor eligibility
deactivate UserRepository
MeetingService-&amp;gt;&amp;gt;MeetingService: Verify actor is current Assigned Approver&amp;lt;br/&amp;gt;and differs from Organizer
alt Actor is not the active, authorized current approver - EX-4
MeetingService--&amp;gt;&amp;gt;MeetingController: Review authorization denied
deactivate MeetingService
MeetingController--&amp;gt;&amp;gt;MeetingPage: Return authorization error
deactivate MeetingController
MeetingPage--&amp;gt;&amp;gt;Approver: You are no longer authorized to review this meeting
else Actor is the active, authorized current approver
activate MeetingController
activate MeetingService
MeetingService-&amp;gt;&amp;gt;MeetingService: Verify meeting is WaitingApproval
alt Meeting is no longer WaitingApproval - EX-2
MeetingService--&amp;gt;&amp;gt;MeetingController: Meeting is no longer awaiting approval
deactivate MeetingService
MeetingController--&amp;gt;&amp;gt;MeetingPage: Return status conflict
deactivate MeetingController
MeetingPage--&amp;gt;&amp;gt;Approver: This meeting is no longer awaiting approval
else Meeting is WaitingApproval
activate MeetingController
activate MeetingService
alt Decision is Approve
MeetingService-&amp;gt;&amp;gt;MeetingRepository: Revalidate actor and status; record Approved status, approval&amp;lt;br/&amp;gt;decision, history and Organizer notification together (BR-38)
activate MeetingRepository
MeetingRepository-&amp;gt;&amp;gt;Database: Save approval decision, status, history and notification as one complete action
activate Database
alt Approval cannot be completed - EX-3
Database--&amp;gt;&amp;gt;MeetingRepository: Decision, status, history or notification could not be completed; previous information unchanged
deactivate Database
MeetingRepository--&amp;gt;&amp;gt;MeetingService: Approval failed
deactivate MeetingRepository
MeetingService--&amp;gt;&amp;gt;MeetingController: Unable to complete the approval decision. Please try again
deactivate MeetingService
MeetingController--&amp;gt;&amp;gt;MeetingPage: Return approval failure; no new notification or invitation issued
deactivate MeetingController
MeetingPage--&amp;gt;&amp;gt;Approver: Unable to complete the approval decision. Please try again
else Meeting approved
activate Database
activate MeetingController
activate MeetingRepository
activate MeetingService
Database--&amp;gt;&amp;gt;MeetingRepository: Approved status, decision, history and Organizer notification recorded together
deactivate Database
MeetingRepository--&amp;gt;&amp;gt;MeetingService: Approval applied
deactivate MeetingRepository
MeetingService--&amp;gt;&amp;gt;MeetingController: MSG43 - Meeting approved successfully
deactivate MeetingService
MeetingController--&amp;gt;&amp;gt;MeetingPage: MSG43 - Meeting approved successfully
deactivate MeetingController
MeetingPage--&amp;gt;&amp;gt;Approver: MSG43 - Meeting approved successfully
end
else Decision is Reject
activate MeetingController
activate MeetingService
MeetingService-&amp;gt;&amp;gt;MeetingService: Trim rejection reason
alt Trimmed reason is empty - EX-1
MeetingService--&amp;gt;&amp;gt;MeetingController: MSG83 - Rejection reason is required
deactivate MeetingService
MeetingController--&amp;gt;&amp;gt;MeetingPage: Return rejection reason validation
deactivate MeetingController
MeetingPage--&amp;gt;&amp;gt;Approver: MSG83 - Rejection reason is required
else Trimmed reason exceeds 1000 characters - EX-5
activate MeetingController
activate MeetingService
MeetingService--&amp;gt;&amp;gt;MeetingController: MSG84 - Rejection reason must not exceed 1000 characters
deactivate MeetingService
MeetingController--&amp;gt;&amp;gt;MeetingPage: Return rejection reason validation
deactivate MeetingController
MeetingPage--&amp;gt;&amp;gt;Approver: MSG84 - Rejection reason must not exceed 1000 characters
else Rejection reason is valid
activate MeetingController
activate MeetingService
MeetingService-&amp;gt;&amp;gt;MeetingRepository: Revalidate actor and status; record Rejected status, rejection reason,&amp;lt;br/&amp;gt;decision, history and Organizer notification with the reason together (BR-38)
activate MeetingRepository
MeetingRepository-&amp;gt;&amp;gt;Database: Save rejection decision, reason, status, history and notification as one complete action
activate Database
alt Rejection cannot be completed - EX-3
Database--&amp;gt;&amp;gt;MeetingRepository: Decision, status, history or notification could not be completed; previous information unchanged
deactivate Database
MeetingRepository--&amp;gt;&amp;gt;MeetingService: Rejection failed
deactivate MeetingRepository
MeetingService--&amp;gt;&amp;gt;MeetingController: Unable to complete the approval decision. Please try again
deactivate MeetingService
MeetingController--&amp;gt;&amp;gt;MeetingPage: Return rejection failure; no new notification or invitation issued
deactivate MeetingController
MeetingPage--&amp;gt;&amp;gt;Approver: Unable to complete the approval decision. Please try again
else Meeting rejected
activate Database
activate MeetingController
activate MeetingRepository
activate MeetingService
Database--&amp;gt;&amp;gt;MeetingRepository: Rejected status, reason, decision, history and Organizer notification recorded together
deactivate Database
MeetingRepository--&amp;gt;&amp;gt;MeetingService: Rejection applied
deactivate MeetingRepository
MeetingService--&amp;gt;&amp;gt;MeetingController: MSG44 - Meeting rejected successfully
deactivate MeetingService
MeetingController--&amp;gt;&amp;gt;MeetingPage: MSG44 - Meeting rejected successfully
deactivate MeetingController
MeetingPage--&amp;gt;&amp;gt;Approver: MSG44 - Meeting rejected successfully
end
end
end
end
end
deactivate MeetingPage
&amp;quot;, &amp;quot;config&amp;quot;: null}">
