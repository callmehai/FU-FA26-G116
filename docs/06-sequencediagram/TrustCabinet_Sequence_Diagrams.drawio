  <diagram id="uc73_handoverchair" name="UC-73 - Hand Over Chair to Another Participant">
    <mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject id="mermaid-uc73_handoverchair" label="" mermaidData="{&quot;data&quot;: &quot;%%{init: {\&quot;sequence\&quot;: {\&quot;mirrorActors\&quot;: false}}}%%\nsequenceDiagram\nactor Chair as \&quot;Chair\&quot;\nparticipant MeetingPage@{ \&quot;type\&quot;: \&quot;boundary\&quot; } as \&quot;Meeting Management Page\&quot;\nparticipant ParticipantController@{ \&quot;type\&quot;: \&quot;control\&quot; } as \&quot;:Meeting Participant Controller\&quot;\nparticipant ParticipantService@{ \&quot;type\&quot;: \&quot;control\&quot; } as \&quot;:Meeting Participant Service\&quot;\nparticipant ParticipantRepository as \&quot;:Meeting Participant Repository\&quot;\nparticipant Database@{ \&quot;type\&quot;: \&quot;database\&quot; } as \&quot;:Database\&quot;\nparticipant NotificationService as \&quot;:Notification Service\&quot;\nChair-&gt;&gt;MeetingPage: Change role on the selected row: choose Chair and confirm Hand over Chair\nactivate MeetingPage\nMeetingPage-&gt;&gt;ParticipantController: Hand over Chair\nactivate ParticipantController\nParticipantController-&gt;&gt;ParticipantService: handOverChair(meetingId, chairId, newChairParticipantId)\nactivate ParticipantService\nParticipantService-&gt;&gt;ParticipantRepository: Read Meeting status, actor's current role&lt;br/&gt;and the selected participant's role and account status\nactivate ParticipantRepository\nParticipantRepository-&gt;&gt;Database: Retrieve current Meeting and roster information\nactivate Database\nDatabase--&gt;&gt;ParticipantRepository: Current information\ndeactivate Database\nParticipantRepository--&gt;&gt;ParticipantService: Current information\ndeactivate ParticipantRepository\nParticipantService-&gt;&gt;ParticipantService: Verify actor is the current Chair and Meeting is Published or InProgress (BR-126)\nalt Hand-over is no longer permitted - EX-2\nParticipantService--&gt;&gt;ParticipantController: MSG260 - You can no longer hand over the Chair role for this meeting.\nParticipantController--&gt;&gt;MeetingPage: MSG260 - You can no longer hand over the Chair role for this meeting.\nMeetingPage--&gt;&gt;Chair: MSG260 - You can no longer hand over the Chair role for this meeting.\nelse Hand-over permitted\nParticipantService-&gt;&gt;ParticipantService: Verify selected person is a current active internal participant,&lt;br/&gt;not a Guest and not the current Secretary (BR-295)\nalt Selected participant can no longer receive the Chair role - EX-1\nParticipantService--&gt;&gt;ParticipantController: MSG259 - The selected participant can no longer receive the Chair role. Select another participant.\nParticipantController--&gt;&gt;MeetingPage: MSG259 - The selected participant can no longer receive the Chair role. Select another participant.\nMeetingPage--&gt;&gt;Chair: MSG259 - The selected participant can no longer receive the Chair role.&lt;br/&gt;Select another participant.\nelse Selected participant eligible\nParticipantService-&gt;&gt;ParticipantRepository: Change selected participant to Chair and former Chair to Member together;&lt;br/&gt;keep System Roles, responses, attendance and ballots (BR-126, BR-169, BR-296)\nactivate ParticipantRepository\nParticipantRepository-&gt;&gt;Database: Save both role changes as one change;&lt;br/&gt;recheck Meeting status and roster before saving\nactivate Database\nDatabase--&gt;&gt;ParticipantRepository: Both roles saved / No changes saved\ndeactivate Database\nParticipantRepository--&gt;&gt;ParticipantService: Both roles saved / No changes saved\ndeactivate ParticipantRepository\nalt Hand-over cannot be saved - EX-3\nParticipantService--&gt;&gt;ParticipantController: MSG102 - Unable to update the meeting role. Please try again.\nParticipantController--&gt;&gt;MeetingPage: MSG102 - Unable to update the meeting role. Please try again.\nMeetingPage--&gt;&gt;Chair: MSG102 - Unable to update the meeting role. Please try again.\nelse Both roles saved\nParticipantService-&gt;&gt;NotificationService: Notify the new Chair and the former Chair;&lt;br/&gt;the actor gets no in-app notification (BR-92, BR-322)\nactivate NotificationService\nNotificationService--&gt;&gt;ParticipantService: Notifications created / delivery failed&lt;br/&gt;(failure does not undo the change)\ndeactivate NotificationService\nParticipantService--&gt;&gt;ParticipantController: MSG257 - Chair role handed over successfully.\nParticipantController--&gt;&gt;MeetingPage: MSG257 - Chair role handed over successfully.\nMeetingPage--&gt;&gt;Chair: MSG257 - Chair role handed over successfully.\nend\nend\nend\ndeactivate ParticipantService\ndeactivate ParticipantController\ndeactivate MeetingPage&quot;, &quot;config&quot;: null}">
          <mxCell connectable="0" parent="1" vertex="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=20;">
            <mxGeometry x="0" y="0" width="3467.0" height="46.0" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="title-uc73_handoverchair" value="UC-73 - Hand Over Chair to Another Participant" vertex="1" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#000000;">
          <mxGeometry x="0.0" y="0" width="3467.0" height="42" as="geometry" />
        </mxCell>
        <UserObject label="Chair" mermaidId="n:Chair" mermaidBaseStyle="html=1;shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;sequenceEdgeStyle&quot;,&quot;libavoidRouting&quot;:0,&quot;curved&quot;:0,&quot;rounded&quot;:0};lifelineDashed=0;strokeWidth=2;rounded=1;absoluteArcSize=1;arcSize=6;lifelineColor=light-dark(#9370DB,#cccccc);participant=seqActorStick;verticalAlign=bottom;align=center;spacingBottom=4;size=90;lifelineMirror=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Chair" id="2">
          <mxCell parent="mermaid-uc73_handoverchair" style="html=1;shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;sequenceEdgeStyle&quot;,&quot;libavoidRouting&quot;:0,&quot;curved&quot;:0,&quot;rounded&quot;:0};lifelineDashed=0;strokeWidth=1.25;rounded=1;absoluteArcSize=1;arcSize=6;lifelineColor=#000000;participant=seqActorStick;verticalAlign=bottom;align=center;spacingBottom=4;size=90;lifelineMirror=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">
            <mxGeometry height="1825" width="150" as="geometry" y="46.0" />
          </mxCell>
