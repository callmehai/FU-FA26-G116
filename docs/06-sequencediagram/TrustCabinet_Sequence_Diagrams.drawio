        <UserObject id="mermaid-uc25_completeagendaitem" label="" mermaidData="{&quot;data&quot;: &quot;%%{init: {\&quot;sequence\&quot;: {\&quot;mirrorActors\&quot;: false}}}%%\nsequenceDiagram\nactor Chair as \&quot;Chair\&quot;\nparticipant MeetingPage@{ \&quot;type\&quot;: \&quot;boundary\&quot; } as \&quot;Meeting Management Page\&quot;\nparticipant AgendaController@{ \&quot;type\&quot;: \&quot;control\&quot; } as \&quot;:Agenda Controller\&quot;\nparticipant AgendaService@{ \&quot;type\&quot;: \&quot;control\&quot; } as \&quot;:Agenda Service\&quot;\nparticipant MeetingRepository as \&quot;:Meeting Repository\&quot;\nparticipant MeetingParticipantRepository as \&quot;:Meeting Participant Repository\&quot;\nparticipant AgendaItemRepository as \&quot;:Agenda Item Repository\&quot;\nparticipant Database@{ \&quot;type\&quot;: \&quot;database\&quot; } as \&quot;:Database\&quot;\nChair-&gt;&gt;MeetingPage: Complete Agenda Item\nactivate MeetingPage\nMeetingPage-&gt;&gt;AgendaController: Complete Agenda Item\nactivate AgendaController\nAgendaController-&gt;&gt;AgendaService: completeAgendaItem(meetingId, agendaItemId, chairId)\nactivate AgendaService\nAgendaService-&gt;&gt;MeetingRepository: Get selected Meeting and current status\nactivate MeetingRepository\nMeetingRepository-&gt;&gt;Database: Get selected Meeting and current status\nactivate Database\nDatabase--&gt;&gt;MeetingRepository: Meeting / Not found\ndeactivate Database\nMeetingRepository--&gt;&gt;AgendaService: Meeting / Not found\ndeactivate MeetingRepository\nAgendaService-&gt;&gt;MeetingParticipantRepository: Check active current Chair assignment\nactivate MeetingParticipantRepository\nMeetingParticipantRepository-&gt;&gt;Database: Check active current Chair assignment\nactivate Database\nDatabase--&gt;&gt;MeetingParticipantRepository: Active Chair / Not eligible\ndeactivate Database\nMeetingParticipantRepository--&gt;&gt;AgendaService: Active Chair / Not eligible\ndeactivate MeetingParticipantRepository\nAgendaService-&gt;&gt;AgendaItemRepository: Get selected Item, Meeting membership and current status\nactivate AgendaItemRepository\nAgendaItemRepository-&gt;&gt;Database: Get selected Item, Meeting membership and current status\nactivate Database\nDatabase--&gt;&gt;AgendaItemRepository: Current Item / Not eligible\ndeactivate Database\nAgendaItemRepository--&gt;&gt;AgendaService: Current Item / Not eligible\ndeactivate AgendaItemRepository\nAgendaService-&gt;&gt;AgendaService: Verify active Chair, Meeting InProgress and&lt;br/&gt;selected Item belongs to this Meeting and is its current InProgress Item;&lt;br/&gt;the Chair may complete it at any time (BR-64, BR-69, BR-72)\nalt Item cannot be completed - EX-1\nAgendaService--&gt;&gt;AgendaController: MSG74 - This agenda item cannot be completed.\nAgendaController--&gt;&gt;MeetingPage: MSG74 - This agenda item cannot be completed.\nMeetingPage--&gt;&gt;Chair: MSG74 - This agenda item cannot be completed.\nelse Completion permitted\nAgendaService-&gt;&gt;AgendaItemRepository: Save Done and actual end time together (BR-70, BR-72)\nactivate AgendaItemRepository\nAgendaItemRepository-&gt;&gt;Database: Save Done and actual end time together (BR-70, BR-72)\nactivate Database\nDatabase--&gt;&gt;AgendaItemRepository: Completed / Save failed; previous state and times preserved\ndeactivate Database\nAgendaItemRepository--&gt;&gt;AgendaService: Completed / Save failed; previous state and times preserved\ndeactivate AgendaItemRepository\nalt Completion cannot be saved - EX-2\nAgendaService--&gt;&gt;AgendaController: MSG76 - Unable to complete the agenda item. Please try again.&lt;br/&gt;Item and Meeting remain InProgress\nAgendaController--&gt;&gt;MeetingPage: MSG76 - Unable to complete the agenda item. Please try again.&lt;br/&gt;Item and Meeting remain InProgress\nMeetingPage--&gt;&gt;Chair: MSG76 - Unable to complete the agenda item. Please try again.&lt;br/&gt;Item and Meeting remain InProgress\nelse Completion saved\nAgendaService-&gt;&gt;AgendaService: Keep Meeting InProgress with no current Item;&lt;br/&gt;do not automatically start another Item (BR-72)\nAgendaService-&gt;&gt;AgendaService: Automatically refresh the complete Agenda&lt;br/&gt;for currently authorized viewers (BR-73)\nAgendaService--&gt;&gt;AgendaController: MSG65 - Agenda item completed successfully.\nAgendaController--&gt;&gt;MeetingPage: MSG65 - Agenda item completed successfully.\nMeetingPage--&gt;&gt;Chair: MSG65 - Agenda item completed successfully.\nend\nend\ndeactivate AgendaService\ndeactivate AgendaController\ndeactivate MeetingPage&quot;, &quot;config&quot;: null}">
