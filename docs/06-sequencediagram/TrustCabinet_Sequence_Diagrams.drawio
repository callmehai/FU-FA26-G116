  <diagram id="uc27_viewmeetingparticipants" name="UC-27 - View Meeting Participants">
    <mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject id="mermaid-uc27_viewmeetingparticipants" label="" mermaidData="{&quot;data&quot;: &quot;%%{init: {\&quot;sequence\&quot;: {\&quot;mirrorActors\&quot;: false}}}%%\nsequenceDiagram\nactor User as \&quot;Secretary / Chair / Member / Guest\&quot;\nparticipant MeetingPage@{ \&quot;type\&quot;: \&quot;boundary\&quot; } as \&quot;Meeting Management Page\&quot;\nparticipant ParticipantController@{ \&quot;type\&quot;: \&quot;control\&quot; } as \&quot;:Meeting Participant Controller\&quot;\nparticipant ParticipantService@{ \&quot;type\&quot;: \&quot;control\&quot; } as \&quot;:Meeting Participant Service\&quot;\nparticipant ParticipantRepository as \&quot;:Meeting Participant Repository\&quot;\nparticipant Database@{ \&quot;type\&quot;: \&quot;database\&quot; } as \&quot;:Database\&quot;\nUser-&gt;&gt;MeetingPage: Request View Meeting Participants with optional name/email search\nactivate MeetingPage\nMeetingPage-&gt;&gt;ParticipantController: Request View Meeting Participants with optional name/email search\nactivate ParticipantController\nParticipantController-&gt;&gt;ParticipantService: viewMeetingParticipants(meeting, user, criteria)\nactivate ParticipantService\nParticipantService-&gt;&gt;ParticipantRepository: Read Meeting status, current internal and Guest roster,&lt;br/&gt;actor relationship, roles and additional permissions\nactivate ParticipantRepository\nParticipantRepository-&gt;&gt;Database: Retrieve current Meeting and roster information\nactivate Database\nDatabase--&gt;&gt;ParticipantRepository: Current information / Read failure\ndeactivate Database\nParticipantRepository--&gt;&gt;ParticipantService: Current information / Read failure\ndeactivate ParticipantRepository\nParticipantService-&gt;&gt;ParticipantService: Verify active current assignment or verified current Guest invitation; Secretary follows existing roster visibility rules;&lt;br/&gt;from Published onward Chair has default access, Member or Guest needs View Meeting Participants (BR-117–BR-121, BR-176)\nalt Meeting does not exist or viewing is not permitted - EX-1\nParticipantService--&gt;&gt;ParticipantController: Meeting not found; no roster or response information disclosed\nParticipantController--&gt;&gt;MeetingPage: Meeting not found; no roster or response information disclosed\nMeetingPage--&gt;&gt;User: Meeting not found; no roster or response information disclosed\nelse Information cannot be loaded - EX-2\nParticipantService--&gt;&gt;ParticipantController: MSG95 - Unable to load meeting participants. Please try again.\nParticipantController--&gt;&gt;MeetingPage: MSG95 - Unable to load meeting participants. Please try again.\nMeetingPage--&gt;&gt;User: MSG95 - Unable to load meeting participants. Please try again.\nelse Viewing is permitted\nParticipantService-&gt;&gt;ParticipantService: Exclude removed/revoked entries from current results and totals (BR-103)\nParticipantService-&gt;&gt;ParticipantService: Apply optional name/email search to the current roster (AF-1)\nParticipantService--&gt;&gt;ParticipantController: Current participant list; no information changed\nParticipantController--&gt;&gt;MeetingPage: Current participant list; no information changed\nMeetingPage--&gt;&gt;User: Current participant list; no information changed\nend\ndeactivate ParticipantService\ndeactivate ParticipantController\ndeactivate MeetingPage\n&quot;, &quot;config&quot;: null}">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=20;" vertex="1">
            <mxGeometry x="0" y="0" width="2630.0" height="46.0" as="geometry" />
          </mxCell>
        </UserObject>
