  <diagram id="uc76b_detachdocumentfromvote" name="UC-76b - Detach Document from Vote">
    <mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject id="mermaid-uc76b_detachdocumentfromvote" label="" mermaidData="{&quot;data&quot;: &quot;%%{init: {\&quot;sequence\&quot;: {\&quot;mirrorActors\&quot;: false}}}%%\nsequenceDiagram\nactor Actor as \&quot;Chair / Secretary\&quot;\nparticipant MeetingPage@{ \&quot;type\&quot;: \&quot;boundary\&quot; } as \&quot;Meeting Management Page\&quot;\nparticipant VoteController@{ \&quot;type\&quot;: \&quot;control\&quot; } as \&quot;:Vote Controller\&quot;\nparticipant VoteService@{ \&quot;type\&quot;: \&quot;control\&quot; } as \&quot;:Vote Service\&quot;\nparticipant ParticipantRepository as \&quot;:Meeting Participant Repository\&quot;\nparticipant VoteRepository as \&quot;:Vote Repository\&quot;\nparticipant Database@{ \&quot;type\&quot;: \&quot;database\&quot; } as \&quot;:Database\&quot;\nActor-&gt;&gt;MeetingPage: Confirm Detach document from a Draft Vote\nactivate MeetingPage\nMeetingPage-&gt;&gt;VoteController: Detach document from Vote\nactivate VoteController\nVoteController-&gt;&gt;VoteService: detachVoteDocument(meetingId, voteId, meetingDocumentId, actorId)\nactivate VoteService\nVoteService-&gt;&gt;VoteRepository: Get Vote, its Meeting and Vote document link\nactivate VoteRepository\nVoteRepository-&gt;&gt;Database: Get Vote, its Meeting and Vote document link\nactivate Database\nDatabase--&gt;&gt;VoteRepository: Vote, Meeting and link / Not found\ndeactivate Database\nVoteRepository--&gt;&gt;VoteService: Vote, Meeting and link / Not found\ndeactivate VoteRepository\nVoteService-&gt;&gt;ParticipantRepository: Check current Chair or Secretary assignment\nactivate ParticipantRepository\nParticipantRepository-&gt;&gt;Database: Check current Chair or Secretary assignment\nactivate Database\nDatabase--&gt;&gt;ParticipantRepository: Current Chair or Secretary / Not eligible\ndeactivate Database\nParticipantRepository--&gt;&gt;VoteService: Current Chair or Secretary / Not eligible\ndeactivate ParticipantRepository\nalt Meeting or Vote not accessible - EX-4\nVoteService--&gt;&gt;VoteController: MSG205 - Meeting votes are not accessible.\nVoteController--&gt;&gt;MeetingPage: MSG205 - Meeting votes are not accessible.\nMeetingPage--&gt;&gt;Actor: MSG205 - Meeting votes are not accessible.\nelse Vote documents can no longer be changed - EX-1\nVoteService--&gt;&gt;VoteController: MSG213 - Only Draft votes may be managed by the current Chair or Secretary&lt;br/&gt;while the meeting is Approved, Published or InProgress.\nVoteController--&gt;&gt;MeetingPage: MSG213 - Only Draft votes may be managed by the current Chair or Secretary&lt;br/&gt;while the meeting is Approved, Published or InProgress.\nMeetingPage--&gt;&gt;Actor: MSG213 - Only Draft votes may be managed by the current Chair or Secretary&lt;br/&gt;while the meeting is Approved, Published or InProgress.\nelse Document no longer attached to the Vote - EX-2\nVoteService--&gt;&gt;VoteController: MSG269 - This document is no longer attached to the vote. Refresh the list.\nVoteController--&gt;&gt;MeetingPage: MSG269 - This document is no longer attached to the vote. Refresh the list.\nMeetingPage--&gt;&gt;Actor: MSG269 - This document is no longer attached to the vote. Refresh the list.\nelse Draft Vote and document still attached (BR-252, BR-288)\nVoteService-&gt;&gt;VoteRepository: Recheck Vote is Draft and remove only this Vote document link;&lt;br/&gt;keep the document in the Meeting with its Agenda Item links,&lt;br/&gt;comments and read confirmations (BR-305)\nactivate VoteRepository\nVoteRepository-&gt;&gt;Database: Remove only this Vote document link\nactivate Database\nDatabase--&gt;&gt;VoteRepository: Detached / Save failed\ndeactivate Database\nVoteRepository--&gt;&gt;VoteService: Detached / Save failed\ndeactivate VoteRepository\nalt Change cannot be saved - EX-3\nVoteService--&gt;&gt;VoteController: MSG270 - Unable to detach the document. No changes were made. Please try again.\nVoteController--&gt;&gt;MeetingPage: MSG270 - Unable to detach the document. No changes were made. Please try again.\nMeetingPage--&gt;&gt;Actor: MSG270 - Unable to detach the document. No changes were made. Please try again.\nelse Document detached\nVoteService--&gt;&gt;VoteController: MSG268 - Document detached from the vote successfully.\nVoteController--&gt;&gt;MeetingPage: MSG268 - Document detached from the vote successfully.\nMeetingPage--&gt;&gt;Actor: MSG268 - Document detached from the vote successfully.\nend\nend\ndeactivate VoteService\ndeactivate VoteController\ndeactivate MeetingPage&quot;, &quot;config&quot;: null}">
          <mxCell connectable="0" parent="1" vertex="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=20;">
            <mxGeometry x="0" y="0" width="3116.0" height="46.0" as="geometry" />
          </mxCell>
        </UserObject>
