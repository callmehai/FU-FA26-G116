  <diagram id="uc10_viewrolepermissionmatrix" name="UC-10 - View Role &amp; Permission Matrix">
    <mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject id="mermaid-uc10_viewrolepermissionmatrix" label="" mermaidData="{&amp;quot;data&amp;quot;: &amp;quot;%%{init: {\&amp;quot;sequence\&amp;quot;: {\&amp;quot;mirrorActors\&amp;quot;: false}}}%%
sequenceDiagram
actor Admin as \&amp;quot;System Admin\&amp;quot;
participant RolePage@{ \&amp;quot;type\&amp;quot;: \&amp;quot;boundary\&amp;quot; } as \&amp;quot;Role &amp;amp; Permission Management Page\&amp;quot;
participant RoleController@{ \&amp;quot;type\&amp;quot;: \&amp;quot;control\&amp;quot; } as \&amp;quot;:Role Permission Controller\&amp;quot;
participant RoleService@{ \&amp;quot;type\&amp;quot;: \&amp;quot;control\&amp;quot; } as \&amp;quot;:Role Permission Service\&amp;quot;
participant RoleRepository as \&amp;quot;:Role Permission Repository\&amp;quot;
participant Database@{ \&amp;quot;type\&amp;quot;: \&amp;quot;database\&amp;quot; } as \&amp;quot;:Database\&amp;quot;
Admin-&amp;gt;&amp;gt;RolePage: Access Role &amp;amp; Permission Management
activate RolePage
RolePage-&amp;gt;&amp;gt;RoleController: Request role and permission matrix
activate RoleController
RoleController-&amp;gt;&amp;gt;RoleService: Get role and permission matrix
activate RoleService
RoleService-&amp;gt;&amp;gt;RoleRepository: Get role and permission matrix
activate RoleRepository
RoleRepository-&amp;gt;&amp;gt;Database: Retrieve role and permission matrix
activate Database
Database--&amp;gt;&amp;gt;RoleRepository: Role and permission matrix
RoleRepository--&amp;gt;&amp;gt;RoleService: Role and permission matrix
RoleService--&amp;gt;&amp;gt;RoleController: Role and permission matrix
RoleController--&amp;gt;&amp;gt;RolePage: Display role and permission matrix
RolePage--&amp;gt;&amp;gt;Admin: Show role and permission matrix
deactivate Database
deactivate RoleRepository
deactivate RoleService
deactivate RoleController
deactivate RolePage
&amp;quot;, &amp;quot;config&amp;quot;: null}">
