        <UserObject id="mermaid-uc26_viewmeetingagenda" label="" mermaidData="{&quot;data&quot;: &quot;%%{init: {\&quot;sequence\&quot;: {\&quot;mirrorActors\&quot;: false}}}%%\nsequenceDiagram\nactor User as \&quot;Meeting Organizer / Meeting Approver / Chair / Secretary / Participant\&quot;\nparticipant MeetingPage@{ \&quot;type\&quot;: \&quot;boundary\&quot; } as \&quot;Meeting Management Page\&quot;\nparticipant AgendaController@{ \&quot;type\&quot;: \&quot;control\&quot; } as \&quot;:Agenda Controller\&quot;\nparticipant AgendaService@{ \&quot;type\&quot;: \&quot;control\&quot; } as \&quot;:Agenda Service\&quot;\nparticipant MeetingRepository as \&quot;:Meeting Repository\&quot;\nparticipant MeetingAccessPolicy as \&quot;:Meeting Access Policy\&quot;\nparticipant AgendaItemRepository as \&quot;:Agenda Item Repository\&quot;\nparticipant Database@{ \&quot;type\&quot;: \&quot;database\&quot; } as \&quot;:Database\&quot;\nUser-&gt;&gt;MeetingPage: Open Meeting Agenda\nactivate MeetingPage\nMeetingPage-&gt;&gt;AgendaController: View Meeting Agenda\nactivate AgendaController\nAgendaController-&gt;&gt;AgendaService: getMeetingAgenda(meetingId, userId)\nactivate AgendaService\nAgendaService-&gt;&gt;MeetingRepository: Get selected Meeting\nactivate MeetingRepository\nMeetingRepository-&gt;&gt;Database: Get selected Meeting\nactivate Database\nDatabase--&gt;&gt;MeetingRepository: Meeting / Not found\ndeactivate Database\nMeetingRepository--&gt;&gt;AgendaService: Meeting / Not found\ndeactivate MeetingRepository\nAgendaService-&gt;&gt;MeetingAccessPolicy: Verify current Meeting access (BR-29)\nactivate MeetingAccessPolicy\nMeetingAccessPolicy--&gt;&gt;AgendaService: Authorized / Not authorized\nalt Meeting not accessible - EX-1\nAgendaService--&gt;&gt;AgendaController: Not found; disclose no Agenda data\nAgendaController--&gt;&gt;MeetingPage: Not found\nMeetingPage--&gt;&gt;User: Meeting Agenda not found\nelse Meeting accessible\nloop Initial load or successful saved Agenda change while view remains open\nAgendaService-&gt;&gt;MeetingAccessPolicy: Recheck Meeting access before displaying latest Agenda (BR-29)\nMeetingAccessPolicy--&gt;&gt;AgendaService: Still authorized / Access ended\nalt Meeting access ended - EX-1\nAgendaService--&gt;&gt;AgendaController: Stop Agenda updates; disclose no further data\nAgendaController--&gt;&gt;MeetingPage: Close protected Agenda view\nMeetingPage--&gt;&gt;User: Meeting Agenda not accessible\nelse User remains authorized\nAgendaService-&gt;&gt;AgendaItemRepository: Retrieve complete latest Agenda in saved order (BR-64, BR-73)\nactivate AgendaItemRepository\nAgendaItemRepository-&gt;&gt;Database: Retrieve complete latest Agenda in saved order (BR-64, BR-73)\nactivate Database\nDatabase--&gt;&gt;AgendaItemRepository: Complete Agenda / Empty Agenda / Retrieval failed\ndeactivate Database\nAgendaItemRepository--&gt;&gt;AgendaService: Complete Agenda / Empty Agenda / Retrieval failed\ndeactivate AgendaItemRepository\nalt Agenda retrieval failed - EX-2\nAgendaService--&gt;&gt;AgendaController: MSG128 - Unable to load the meeting agenda. Please try again.\nAgendaController--&gt;&gt;MeetingPage: Agenda refresh failed; do not represent old data as latest\nMeetingPage--&gt;&gt;User: MSG128 - Unable to load the meeting agenda. Please try again.\nelse Latest Agenda retrieved\nAgendaService--&gt;&gt;AgendaController: Complete Agenda with current order, execution data and Item conclusions\nAgendaController--&gt;&gt;MeetingPage: Complete latest saved Agenda\nalt No Items exist - AF-1\nMeetingPage--&gt;&gt;User: Display empty Agenda; keep view ready for saved changes\nelse Agenda contains Items\nMeetingPage--&gt;&gt;User: Automatically display full Agenda: title, presenter, order, status, actual times&lt;br/&gt;and any Item conclusion with who last saved it and when (BR-311)\nend\nend\nend\nend\nend\ndeactivate AgendaService\ndeactivate AgendaController\ndeactivate MeetingPage\ndeactivate MeetingAccessPolicy&quot;, &quot;config&quot;: null}">
          <mxCell connectable="0" parent="1" vertex="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=20;">
            <mxGeometry x="0" y="0" width="3218.0" height="46.0" as="geometry" />
          </mxCell>
        </UserObject>
