  <diagram id="uc66_viewnotifications" name="UC-66 - View Notifications">
    <mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject id="mermaid-uc66_viewnotifications" label="" mermaidData="{&amp;quot;data&amp;quot;: &amp;quot;%%{init: {\&amp;quot;sequence\&amp;quot;: {\&amp;quot;mirrorActors\&amp;quot;: false}}}%%
sequenceDiagram
actor User as \&amp;quot;Meeting Organizer / Meeting Approver / System Admin / Chair / Secretary / Participant\&amp;quot;
participant NotificationPanel@{ \&amp;quot;type\&amp;quot;: \&amp;quot;boundary\&amp;quot; } as \&amp;quot;Notification Panel\&amp;quot;
participant NotificationController@{ \&amp;quot;type\&amp;quot;: \&amp;quot;control\&amp;quot; } as \&amp;quot;:Notification Controller\&amp;quot;
participant NotificationService@{ \&amp;quot;type\&amp;quot;: \&amp;quot;control\&amp;quot; } as \&amp;quot;:Notification Service\&amp;quot;
participant NotificationRepository as \&amp;quot;:Notification Repository\&amp;quot;
participant Database@{ \&amp;quot;type\&amp;quot;: \&amp;quot;database\&amp;quot; } as \&amp;quot;:Database\&amp;quot;
User-&amp;gt;&amp;gt;NotificationPanel: Select notification bell
activate NotificationPanel
NotificationPanel-&amp;gt;&amp;gt;NotificationController: Request notifications and unread count
activate NotificationController
NotificationController-&amp;gt;&amp;gt;NotificationService: Get notifications for current user
activate NotificationService
NotificationService-&amp;gt;&amp;gt;NotificationRepository: Get notifications and unread count&amp;lt;br/&amp;gt;without changing read status (BR-48, BR-49)
activate NotificationRepository
NotificationRepository-&amp;gt;&amp;gt;Database: Retrieve user notifications&amp;lt;br/&amp;gt;and unread count
activate Database
alt Notifications cannot be retrieved - EX-1
Database--&amp;gt;&amp;gt;NotificationRepository: Retrieval failed
NotificationRepository--&amp;gt;&amp;gt;NotificationService: Unable to retrieve notifications
NotificationService--&amp;gt;&amp;gt;NotificationController: Notifications cannot be loaded
NotificationController--&amp;gt;&amp;gt;NotificationPanel: Display notification loading error
NotificationPanel--&amp;gt;&amp;gt;User: Inform notifications cannot be loaded
else Notifications retrieved successfully
Database--&amp;gt;&amp;gt;NotificationRepository: Notifications and unread count
NotificationRepository--&amp;gt;&amp;gt;NotificationService: Notification list and unread count
NotificationService--&amp;gt;&amp;gt;NotificationController: Notification list and unread count
NotificationController--&amp;gt;&amp;gt;NotificationPanel: Display notifications and unread badge
NotificationPanel--&amp;gt;&amp;gt;User: Show notifications, unread indicators and unread count
end
deactivate Database
deactivate NotificationRepository
deactivate NotificationService
deactivate NotificationController
deactivate NotificationPanel
&amp;quot;, &amp;quot;config&amp;quot;: null}">
