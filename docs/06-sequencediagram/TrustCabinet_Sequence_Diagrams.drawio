  <diagram id="uc01_signin" name="UC-01 - Sign in with Username and Password">
    <mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject id="mermaid-uc01_signin" label="" mermaidData="{&amp;quot;data&amp;quot;: &amp;quot;%%{init: {\&amp;quot;sequence\&amp;quot;: {\&amp;quot;mirrorActors\&amp;quot;: false}}}%%
sequenceDiagram
actor User as \&amp;quot;User\&amp;quot;
participant LoginPage@{ \&amp;quot;type\&amp;quot;: \&amp;quot;boundary\&amp;quot; } as \&amp;quot;Login Page\&amp;quot;
participant AuthController@{ \&amp;quot;type\&amp;quot;: \&amp;quot;control\&amp;quot; } as \&amp;quot;:Auth Controller\&amp;quot;
participant AuthService as \&amp;quot;:Authentication Service\&amp;quot;
participant UserRepository as \&amp;quot;:User Repository\&amp;quot;
participant Database@{ \&amp;quot;type\&amp;quot;: \&amp;quot;database\&amp;quot; } as \&amp;quot;Database\&amp;quot;
User-&amp;gt;&amp;gt;LoginPage: Enter email and password
activate LoginPage
User-&amp;gt;&amp;gt;LoginPage: Click \&amp;quot;Sign In\&amp;quot;
LoginPage-&amp;gt;&amp;gt;AuthController: signIn(username, password)
activate AuthController
AuthController-&amp;gt;&amp;gt;AuthService: signIn(username, password)
activate AuthService
AuthService-&amp;gt;&amp;gt;UserRepository: Find user by username
activate UserRepository
UserRepository-&amp;gt;&amp;gt;Database: Get user account
activate Database
Database--&amp;gt;&amp;gt;UserRepository: User account or not found
UserRepository--&amp;gt;&amp;gt;AuthService: User account or not found
alt Invalid username or password
AuthService--&amp;gt;&amp;gt;AuthController: Invalid credentials
AuthController--&amp;gt;&amp;gt;LoginPage: MSG01 - Invalid email or password
LoginPage--&amp;gt;&amp;gt;User: Display error message
else Internal account is deactivated
AuthService--&amp;gt;&amp;gt;AuthController: Account deactivated
AuthController--&amp;gt;&amp;gt;LoginPage: MSG03 - Account unavailable
LoginPage--&amp;gt;&amp;gt;User: Display error message
else User has no active role or access
AuthService--&amp;gt;&amp;gt;AuthController: Access denied
AuthController--&amp;gt;&amp;gt;LoginPage: MSG04 - No system access
LoginPage--&amp;gt;&amp;gt;User: Display error message
else User is authorized
AuthService--&amp;gt;&amp;gt;AuthController: Sign in successful
AuthController--&amp;gt;&amp;gt;LoginPage: Redirect to authenticated page
LoginPage--&amp;gt;&amp;gt;User: Display authenticated page
end
deactivate Database
deactivate UserRepository
deactivate AuthService
deactivate AuthController
deactivate LoginPage
&amp;quot;, &amp;quot;config&amp;quot;: null}">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=20;" vertex="1">
            <mxGeometry x="0" y="0" width="1413.0" height="46.0" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="title-uc01_signin" value="UC-01 - Sign in with Username and Password" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="0.0" y="0" width="1413.0" height="42" as="geometry" />
