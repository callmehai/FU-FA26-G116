  <diagram id="uc74_confirmdocumentread" name="UC-74 - Confirm Document Read">
    <mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject id="mermaid-uc74_confirmdocumentread" label="" mermaidData="{&quot;data&quot;: &quot;%%{init: {\&quot;sequence\&quot;: {\&quot;mirrorActors\&quot;: false}}}%%\nsequenceDiagram\nactor User as \&quot;Chair / Secretary / Participant / Guest\&quot;\nparticipant DocumentViewer@{ \&quot;type\&quot;: \&quot;boundary\&quot; } as \&quot;Document Viewer\&quot;\nparticipant DocumentController@{ \&quot;type\&quot;: \&quot;control\&quot; } as \&quot;:Document Controller\&quot;\nparticipant ReadService@{ \&quot;type\&quot;: \&quot;control\&quot; } as \&quot;:Document Read Service\&quot;\nparticipant MeetingAccessPolicy as \&quot;:Meeting Access Policy\&quot;\nparticipant MeetingDocumentRepository as \&quot;:Meeting Document Repository\&quot;\nparticipant ReadConfirmationRepository as \&quot;:Document Read Confirmation Repository\&quot;\nparticipant Database@{ \&quot;type\&quot;: \&quot;database\&quot; } as \&quot;:Database\&quot;\nUser-&gt;&gt;DocumentViewer: Tick \&quot;I have read this document\&quot;\nactivate DocumentViewer\nDocumentViewer-&gt;&gt;DocumentViewer: Check the last page of the document was reached in this viewer (BR-290)\nalt Last page not reached - EX-1\nDocumentViewer--&gt;&gt;User: MSG254 - Scroll to the last page of the document before confirming that you have read it.\nelse Last page reached\nDocumentViewer-&gt;&gt;DocumentController: Confirm document read (last page reached)\nactivate DocumentController\nDocumentController-&gt;&gt;ReadService: confirmDocumentRead(meetingId, meetingDocumentId, actorId, lastPageReached)\nactivate ReadService\nReadService-&gt;&gt;MeetingAccessPolicy: Check actor can currently view the Meeting (BR-181, BR-275)\nactivate MeetingAccessPolicy\nMeetingAccessPolicy-&gt;&gt;Database: Check current Meeting relationship or valid Guest invitation\nactivate Database\nDatabase--&gt;&gt;MeetingAccessPolicy: Access / No access\ndeactivate Database\nMeetingAccessPolicy--&gt;&gt;ReadService: Access / No access\ndeactivate MeetingAccessPolicy\nReadService-&gt;&gt;MeetingDocumentRepository: Check document is attached to the Meeting and linked to a Vote (BR-287)\nactivate MeetingDocumentRepository\nMeetingDocumentRepository-&gt;&gt;Database: Check document is attached to the Meeting and linked to a Vote (BR-287)\nactivate Database\nDatabase--&gt;&gt;MeetingDocumentRepository: Vote document / Not available\ndeactivate Database\nMeetingDocumentRepository--&gt;&gt;ReadService: Vote document / Not available\ndeactivate MeetingDocumentRepository\nalt Document or Meeting no longer accessible - EX-2\nReadService--&gt;&gt;DocumentController: MSG156 - Meeting documents are not accessible.\nDocumentController--&gt;&gt;DocumentViewer: MSG156 - Meeting documents are not accessible.\nDocumentViewer--&gt;&gt;User: MSG156 - Meeting documents are not accessible.\nelse Vote document accessible\nReadService-&gt;&gt;ReadConfirmationRepository: Get existing confirmation for actor and document\nactivate ReadConfirmationRepository\nReadConfirmationRepository-&gt;&gt;Database: Get existing confirmation for actor and document\nactivate Database\nDatabase--&gt;&gt;ReadConfirmationRepository: Confirmation and time / None\ndeactivate Database\nReadConfirmationRepository--&gt;&gt;ReadService: Confirmation and time / None\ndeactivate ReadConfirmationRepository\nalt Document already confirmed - AF-1\nReadService--&gt;&gt;DocumentController: Already read at confirmation time (BR-291)\nDocumentController--&gt;&gt;DocumentViewer: Already read at confirmation time\nDocumentViewer--&gt;&gt;User: Show document as read with its confirmation time\nelse Not yet confirmed\nReadService-&gt;&gt;ReadService: Recheck last page reached (BR-290)\nalt Last page not reached - EX-1\nReadService--&gt;&gt;DocumentController: MSG254 - Scroll to the last page of the document before confirming that you have read it.\nDocumentController--&gt;&gt;DocumentViewer: MSG254 - Scroll to the last page of the document before confirming that you have read it.\nDocumentViewer--&gt;&gt;User: MSG254 - Scroll to the last page of the document before confirming that you have read it.\nelse Last page reached\nReadService-&gt;&gt;ReadConfirmationRepository: Save confirmation with actor, document and time;&lt;br/&gt;not linked to any ballot choice (BR-290, BR-291, BR-293)\nactivate ReadConfirmationRepository\nReadConfirmationRepository-&gt;&gt;Database: Save confirmation with actor, document and time;&lt;br/&gt;not linked to any ballot choice (BR-290, BR-291, BR-293)\nactivate Database\nDatabase--&gt;&gt;ReadConfirmationRepository: Confirmation saved / Save failed\ndeactivate Database\nReadConfirmationRepository--&gt;&gt;ReadService: Confirmation saved / Save failed\ndeactivate ReadConfirmationRepository\nalt Confirmation cannot be saved - EX-3\nReadService--&gt;&gt;DocumentController: MSG255 - Unable to confirm document reading. Please try again.\nDocumentController--&gt;&gt;DocumentViewer: MSG255 - Unable to confirm document reading. Please try again.\nDocumentViewer--&gt;&gt;User: MSG255 - Unable to confirm document reading. Please try again.\nelse Confirmation saved\nReadService--&gt;&gt;DocumentController: MSG253 - Document read confirmed.\nDocumentController--&gt;&gt;DocumentViewer: MSG253 - Document read confirmed.\nDocumentViewer--&gt;&gt;User: MSG253 - Document read confirmed.\nend\nend\nend\nend\ndeactivate ReadService\ndeactivate DocumentController\nend\ndeactivate DocumentViewer&quot;, &quot;config&quot;: null}">
          <mxCell connectable="0" parent="1" vertex="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=20;">
            <mxGeometry x="0" y="0" width="3857.0" height="46.0" as="geometry" />
