  <diagram id="uc02_signinwithgoogle" name="UC-02 - Sign in with Google">
    <mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject id="mermaid-uc02_signinwithgoogle" label="" mermaidData="{&amp;quot;data&amp;quot;: &amp;quot;%%{init: {\&amp;quot;sequence\&amp;quot;: {\&amp;quot;mirrorActors\&amp;quot;: false}}}%%
sequenceDiagram
actor User as \&amp;quot;User\&amp;quot;
participant LoginPage@{ \&amp;quot;type\&amp;quot;: \&amp;quot;boundary\&amp;quot; } as \&amp;quot;Login Page\&amp;quot;
participant Google as \&amp;quot;:Google\&amp;quot;
participant AuthController@{ \&amp;quot;type\&amp;quot;: \&amp;quot;control\&amp;quot; } as \&amp;quot;:AuthController\&amp;quot;
participant AuthenticationService as \&amp;quot;:AuthenticationService\&amp;quot;
participant UserRepository as \&amp;quot;:UserRepository\&amp;quot;
participant Database@{ \&amp;quot;type\&amp;quot;: \&amp;quot;database\&amp;quot; } as \&amp;quot;:Database\&amp;quot;
User-&amp;gt;&amp;gt;LoginPage: Click \&amp;quot;Continue with Google\&amp;quot;
activate LoginPage
LoginPage-&amp;gt;&amp;gt;Google: Open Google sign-in
activate Google
User-&amp;gt;&amp;gt;Google: Select Google account and sign in
alt Google authentication failed or cancelled
Google--&amp;gt;&amp;gt;LoginPage: Authentication failed
LoginPage--&amp;gt;&amp;gt;User: MSG01 - Google sign-in unsuccessful
else Google authentication successful
Google--&amp;gt;&amp;gt;LoginPage: Return authenticated Google account
LoginPage-&amp;gt;&amp;gt;AuthController: signInWithGoogle(googleAccount)
activate AuthController
AuthController-&amp;gt;&amp;gt;AuthenticationService: signInWithGoogle(googleAccount)
activate AuthenticationService
AuthenticationService-&amp;gt;&amp;gt;UserRepository: Find internal account by Google account
activate UserRepository
UserRepository-&amp;gt;&amp;gt;Database: Get linked user account
activate Database
Database--&amp;gt;&amp;gt;UserRepository: User account or not found
UserRepository--&amp;gt;&amp;gt;AuthenticationService: User account or not found
alt Google account is not linked
AuthenticationService--&amp;gt;&amp;gt;AuthController: Internal account not found
AuthController--&amp;gt;&amp;gt;LoginPage: MSG03 - Google account not authorized
LoginPage--&amp;gt;&amp;gt;User: Display error message
else Internal account is deactivated
AuthenticationService--&amp;gt;&amp;gt;AuthController: Account deactivated
AuthController--&amp;gt;&amp;gt;LoginPage: MSG04 - Account unavailable
LoginPage--&amp;gt;&amp;gt;User: Display error message
else User has no active role or access
AuthenticationService--&amp;gt;&amp;gt;AuthController: Access denied
AuthController--&amp;gt;&amp;gt;LoginPage: MSG05 - No system access
LoginPage--&amp;gt;&amp;gt;User: Display error message
else User is authorized
AuthenticationService--&amp;gt;&amp;gt;AuthController: Sign in successful
AuthController--&amp;gt;&amp;gt;LoginPage: Sign in successful
LoginPage--&amp;gt;&amp;gt;User: Redirect to authenticated page
end
deactivate Database
deactivate UserRepository
deactivate AuthenticationService
deactivate AuthController
end
deactivate Google
deactivate LoginPage
&amp;quot;, &amp;quot;config&amp;quot;: null}">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=20;" vertex="1">
