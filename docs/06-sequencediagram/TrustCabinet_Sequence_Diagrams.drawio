  <diagram id="uc14_createmeeting" name="UC-14 - Create Meeting">
    <mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject id="mermaid-uc14_createmeeting" label="" mermaidData="{&amp;quot;data&amp;quot;: &amp;quot;%%{init: {\&amp;quot;sequence\&amp;quot;: {\&amp;quot;mirrorActors\&amp;quot;: false}}}%%
sequenceDiagram
actor Organizer as \&amp;quot;Meeting Organizer\&amp;quot;
participant MeetingPage@{ \&amp;quot;type\&amp;quot;: \&amp;quot;boundary\&amp;quot; } as \&amp;quot;Meeting Management Page\&amp;quot;
participant MeetingController@{ \&amp;quot;type\&amp;quot;: \&amp;quot;control\&amp;quot; } as \&amp;quot;:Meeting Controller\&amp;quot;
participant MeetingService@{ \&amp;quot;type\&amp;quot;: \&amp;quot;control\&amp;quot; } as \&amp;quot;:Meeting Service\&amp;quot;
participant MeetingRepository as \&amp;quot;:Meeting Repository\&amp;quot;
participant Database@{ \&amp;quot;type\&amp;quot;: \&amp;quot;database\&amp;quot; } as \&amp;quot;:Database\&amp;quot;
Organizer-&amp;gt;&amp;gt;MeetingPage: Submit meeting information
activate MeetingPage
MeetingPage-&amp;gt;&amp;gt;MeetingController: Create meeting
activate MeetingController
MeetingController-&amp;gt;&amp;gt;MeetingService: createMeeting(meetingInfo)
activate MeetingService
MeetingService-&amp;gt;&amp;gt;MeetingService: Validate required meeting information, Planned Start Time in the future&amp;lt;br/&amp;gt;and Planned End Time after Planned Start Time (BR-24, BR-62, BR-162)
alt Meeting information is invalid - EX-1
MeetingService--&amp;gt;&amp;gt;MeetingController: MSG31 - Invalid meeting information
deactivate MeetingService
MeetingController--&amp;gt;&amp;gt;MeetingPage: Return validation errors
deactivate MeetingController
MeetingPage--&amp;gt;&amp;gt;Organizer: MSG31 - Invalid meeting information
else Meeting information is valid
activate MeetingController
activate MeetingService
MeetingService-&amp;gt;&amp;gt;MeetingRepository: Create meeting with Draft status&amp;lt;br/&amp;gt;(BR-26)
activate MeetingRepository
MeetingRepository-&amp;gt;&amp;gt;Database: Insert meeting
activate Database
alt Meeting cannot be created - EX-2
Database--&amp;gt;&amp;gt;MeetingRepository: Creation failed
deactivate Database
MeetingRepository--&amp;gt;&amp;gt;MeetingService: Meeting creation failed
deactivate MeetingRepository
MeetingService--&amp;gt;&amp;gt;MeetingController: MSG35 - Unable to create the meeting.&amp;lt;br/&amp;gt;Please try again
deactivate MeetingService
MeetingController--&amp;gt;&amp;gt;MeetingPage: Return meeting creation failure
deactivate MeetingController
MeetingPage--&amp;gt;&amp;gt;Organizer: MSG35 - Unable to create the meeting.&amp;lt;br/&amp;gt;Please try again
else Meeting created successfully
activate Database
activate MeetingController
activate MeetingRepository
activate MeetingService
Database--&amp;gt;&amp;gt;MeetingRepository: Meeting created
deactivate Database
MeetingRepository--&amp;gt;&amp;gt;MeetingService: Created meeting
deactivate MeetingRepository
MeetingService--&amp;gt;&amp;gt;MeetingController: Meeting created successfully
deactivate MeetingService
MeetingController--&amp;gt;&amp;gt;MeetingPage: MSG29 - Meeting created successfully
deactivate MeetingController
MeetingPage--&amp;gt;&amp;gt;Organizer: MSG29 - Meeting created successfully
end
end
deactivate MeetingPage
&amp;quot;, &amp;quot;config&amp;quot;: null}">
