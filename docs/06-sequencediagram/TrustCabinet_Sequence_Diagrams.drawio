  <diagram id="uc17_viewmeetinglist" name="UC-17 - View Meeting List">
    <mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject id="mermaid-uc17_viewmeetinglist" label="" mermaidData="{&quot;data&quot;: &quot;%%{init: {\&quot;sequence\&quot;: {\&quot;mirrorActors\&quot;: false}}}%%\nsequenceDiagram\nactor User as \&quot;Meeting Organizer / Meeting Approver / Chair / Secretary / Participant\&quot;\nparticipant MeetingPage@{ \&quot;type\&quot;: \&quot;boundary\&quot; } as \&quot;Meeting Management Page\&quot;\nparticipant MeetingController@{ \&quot;type\&quot;: \&quot;control\&quot; } as \&quot;:Meeting Controller\&quot;\nparticipant MeetingService@{ \&quot;type\&quot;: \&quot;control\&quot; } as \&quot;:Meeting Service\&quot;\nparticipant MeetingRepository as \&quot;:Meeting Repository\&quot;\nparticipant Database@{ \&quot;type\&quot;: \&quot;database\&quot; } as \&quot;:Database\&quot;\nUser-&gt;&gt;MeetingPage: Request meeting list with current criteria&lt;br/&gt;(opens with status=InProgress preset)\nactivate MeetingPage\nMeetingPage-&gt;&gt;MeetingController: View meeting list\nactivate MeetingController\nMeetingController-&gt;&gt;MeetingController: Validate search, filter, sorting, and paging criteria&lt;br/&gt;(status, timing=upcoming|past, from/to for Today and This week, excludeDeclined)\nalt Query criteria are invalid - EX-2\nMeetingController--&gt;&gt;MeetingPage: MSG32 - Invalid query parameters\ndeactivate MeetingController\nMeetingPage--&gt;&gt;User: MSG32 - Invalid query parameters\nelse Query criteria are valid\nactivate MeetingController\nMeetingController-&gt;&gt;MeetingService: getMeetingList(userId, criteria)\nactivate MeetingService\nMeetingService-&gt;&gt;MeetingRepository: Find authorized meetings with criteria&lt;br/&gt;(BR-29, BR-30, BR-31, BR-32)\nactivate MeetingRepository\nMeetingRepository-&gt;&gt;Database: Filter authorized meetings by name, status (including Cancelled), confidentiality,&lt;br/&gt;Today/This week overlapping Meeting Planned Start/End Time, or Not yet held/Already held by Planned Start Time&lt;br/&gt;(BR-30, BR-297); omit declined meetings only when excludeDeclined=true (calendar, BR-321)\nactivate Database\nalt Meeting list cannot be retrieved - EX-1\nDatabase--&gt;&gt;MeetingRepository: Retrieval failed\ndeactivate Database\nMeetingRepository--&gt;&gt;MeetingService: Meeting list retrieval failed\ndeactivate MeetingRepository\nMeetingService--&gt;&gt;MeetingController: MSG38 - Unable to load meetings.&lt;br/&gt;Please try again\ndeactivate MeetingService\nMeetingController--&gt;&gt;MeetingPage: Return meeting list loading failure\ndeactivate MeetingController\nMeetingPage--&gt;&gt;User: MSG38 - Unable to load meetings.&lt;br/&gt;Please try again\nelse Meeting list retrieved successfully\nactivate Database\nactivate MeetingController\nactivate MeetingRepository\nactivate MeetingService\nDatabase--&gt;&gt;MeetingRepository: Authorized meeting page\ndeactivate Database\nMeetingRepository--&gt;&gt;MeetingService: Meeting list or empty list\ndeactivate MeetingRepository\nMeetingService--&gt;&gt;MeetingController: Meeting list or empty list\ndeactivate MeetingService\nMeetingController--&gt;&gt;MeetingPage: Display meeting list\ndeactivate MeetingController\nMeetingPage--&gt;&gt;User: Meeting list with status, including Cancelled Meetings and Meetings the user declined,&lt;br/&gt;or no matching meetings\nend\nend\ndeactivate MeetingPage&quot;, &quot;config&quot;: null}">
          <mxCell connectable="0" parent="1" vertex="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=20;">
            <mxGeometry x="0" y="0" width="2407.0" height="46.0" as="geometry" />
          </mxCell>
        </UserObject>
