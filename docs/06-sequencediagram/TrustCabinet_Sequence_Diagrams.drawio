  <diagram id="uc03_signout" name="UC-03 - Sign Out">
    <mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject id="mermaid-uc03_signout" label="" mermaidData="{&amp;quot;data&amp;quot;: &amp;quot;%%{init: {\&amp;quot;sequence\&amp;quot;: {\&amp;quot;mirrorActors\&amp;quot;: false}}}%%
sequenceDiagram
actor User as \&amp;quot;User\&amp;quot;
participant AuthenticatedPage@{ \&amp;quot;type\&amp;quot;: \&amp;quot;boundary\&amp;quot; } as \&amp;quot;Authenticated Page\&amp;quot;
User-&amp;gt;&amp;gt;AuthenticatedPage: Select \&amp;quot;Sign Out\&amp;quot;
activate AuthenticatedPage
AuthenticatedPage--&amp;gt;&amp;gt;User: Display confirmation message
User-&amp;gt;&amp;gt;AuthenticatedPage: Confirm sign out
AuthenticatedPage-&amp;gt;&amp;gt;AuthenticatedPage: Remove JWT authentication token
alt JWT cannot be cleared
AuthenticatedPage--&amp;gt;&amp;gt;User: MSG01 - Unable to sign out. Please try again.
else JWT removed successfully
AuthenticatedPage--&amp;gt;&amp;gt;User: Redirect to login page
end
