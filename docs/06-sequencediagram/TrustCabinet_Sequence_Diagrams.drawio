  <diagram id="uc75_cancelmeeting" name="UC-75 - Cancel Meeting">
    <mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject id="mermaid-uc75_cancelmeeting" label="" mermaidData="{&quot;data&quot;: &quot;%%{init: {\&quot;sequence\&quot;: {\&quot;mirrorActors\&quot;: false}}}%%\nsequenceDiagram\nactor Organizer as \&quot;Meeting Organizer\&quot;\nparticipant MeetingPage@{ \&quot;type\&quot;: \&quot;boundary\&quot; } as \&quot;Meeting Management Page\&quot;\nparticipant MeetingController@{ \&quot;type\&quot;: \&quot;control\&quot; } as \&quot;:Meeting Controller\&quot;\nparticipant MeetingService@{ \&quot;type\&quot;: \&quot;control\&quot; } as \&quot;:Meeting Service\&quot;\nparticipant MeetingRepository as \&quot;:Meeting Repository\&quot;\nparticipant ParticipantRepository as \&quot;:Meeting Participant Repository\&quot;\nparticipant NotificationService as \&quot;:Notification Service\&quot;\nparticipant InvitationQueue as \&quot;:Meeting Invitation Queue\&quot;\nparticipant Database@{ \&quot;type\&quot;: \&quot;database\&quot; } as \&quot;:Database\&quot;\nOrganizer-&gt;&gt;MeetingPage: Confirm Cancel meeting with a cancellation reason\nactivate MeetingPage\nMeetingPage-&gt;&gt;MeetingController: Cancel meeting\nactivate MeetingController\nMeetingController-&gt;&gt;MeetingService: cancelMeeting(meetingId, organizerId, reason)\nactivate MeetingService\nMeetingService-&gt;&gt;MeetingRepository: Get Meeting, its Organizer and current status\nactivate MeetingRepository\nMeetingRepository-&gt;&gt;Database: Retrieve Meeting\nactivate Database\nDatabase--&gt;&gt;MeetingRepository: Meeting and status\ndeactivate Database\nMeetingRepository--&gt;&gt;MeetingService: Meeting and status\ndeactivate MeetingRepository\nMeetingService-&gt;&gt;MeetingService: Verify actor is the Meeting Organizer and Meeting is Draft,&lt;br/&gt;WaitingApproval, Rejected, Approved or Published (BR-297)\nalt Meeting can no longer be cancelled - EX-2\nMeetingService--&gt;&gt;MeetingController: MSG263 - This meeting can no longer be cancelled.\nMeetingController--&gt;&gt;MeetingPage: MSG263 - This meeting can no longer be cancelled.\nMeetingPage--&gt;&gt;Organizer: MSG263 - This meeting can no longer be cancelled.\nelse Cancellation permitted\nMeetingService-&gt;&gt;MeetingService: Validate cancellation reason is not blank (BR-298)\nalt Cancellation reason is missing - EX-1\nMeetingService--&gt;&gt;MeetingController: MSG262 - Enter a reason for cancelling the meeting.\nMeetingController--&gt;&gt;MeetingPage: MSG262 - Enter a reason for cancelling the meeting.\nMeetingPage--&gt;&gt;Organizer: MSG262 - Enter a reason for cancelling the meeting.\nelse Reason provided\nMeetingService-&gt;&gt;MeetingRepository: Recheck status, set Cancelled, record reason, actor and time&lt;br/&gt;in status history and close any pending approval request together (BR-38, BR-298, BR-299)\nactivate MeetingRepository\nMeetingRepository-&gt;&gt;Database: Save status, history and approval request as one change\nactivate Database\nDatabase--&gt;&gt;MeetingRepository: Cancelled / Save failed; Meeting unchanged\ndeactivate Database\nMeetingRepository--&gt;&gt;MeetingService: Cancelled / Save failed; Meeting unchanged\ndeactivate MeetingRepository\nalt Cancellation cannot be saved - EX-3\nMeetingService--&gt;&gt;MeetingController: MSG264 - Unable to cancel the meeting. Please try again.\nMeetingController--&gt;&gt;MeetingPage: MSG264 - Unable to cancel the meeting. Please try again.\nMeetingPage--&gt;&gt;Organizer: MSG264 - Unable to cancel the meeting. Please try again.\nelse Meeting cancelled\nopt Meeting was Published\nMeetingService-&gt;&gt;ParticipantRepository: Get current invited internal participants and Guests\nactivate ParticipantRepository\nParticipantRepository-&gt;&gt;Database: Get invited internal participants and Guests\nactivate Database\nDatabase--&gt;&gt;ParticipantRepository: Invitees\ndeactivate Database\nParticipantRepository--&gt;&gt;MeetingService: Invitees\ndeactivate ParticipantRepository\nMeetingService-&gt;&gt;NotificationService: Notify invited internal participants in the application with the reason (BR-300)\nactivate NotificationService\nNotificationService--&gt;&gt;MeetingService: Notifications created / delivery failed&lt;br/&gt;(failure does not undo the cancellation)\ndeactivate NotificationService\nMeetingService-&gt;&gt;InvitationQueue: Queue cancellation emails to invited internal participants and Guests&lt;br/&gt;with the reason (BR-300)\nactivate InvitationQueue\nInvitationQueue--&gt;&gt;MeetingService: Delivery arranged / retry delivery;&lt;br/&gt;Meeting remains Cancelled\ndeactivate InvitationQueue\nend\nMeetingService--&gt;&gt;MeetingController: MSG261 - Meeting cancelled successfully.\nMeetingController--&gt;&gt;MeetingPage: MSG261 - Meeting cancelled successfully.\nMeetingPage--&gt;&gt;Organizer: MSG261 - Meeting cancelled successfully.\nend\nend\nend\ndeactivate MeetingService\ndeactivate MeetingController\ndeactivate MeetingPage&quot;, &quot;config&quot;: null}">
          <mxCell connectable="0" parent="1" vertex="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=20;">
            <mxGeometry x="0" y="0" width="3161.0" height="46.0" as="geometry" />
          </mxCell>
        </UserObject>
