  <diagram id="uc08_assignsystemroletouser" name="UC-08 - Assign System Role to User">
    <mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject id="mermaid-uc08_assignsystemroletouser" label="" mermaidData="{&amp;quot;data&amp;quot;: &amp;quot;%%{init: {\&amp;quot;sequence\&amp;quot;: {\&amp;quot;mirrorActors\&amp;quot;: false}}}%%
sequenceDiagram
actor Admin as \&amp;quot;System Admin\&amp;quot;
participant UserPage@{ \&amp;quot;type\&amp;quot;: \&amp;quot;boundary\&amp;quot; } as \&amp;quot;User Management Page\&amp;quot;
participant UserController@{ \&amp;quot;type\&amp;quot;: \&amp;quot;control\&amp;quot; } as \&amp;quot;:User Controller\&amp;quot;
participant UserService@{ \&amp;quot;type\&amp;quot;: \&amp;quot;control\&amp;quot; } as \&amp;quot;:User Service\&amp;quot;
participant UserRepository as \&amp;quot;:User Repository\&amp;quot;
participant RoleRepository as \&amp;quot;:Role Repository\&amp;quot;
participant AuditLogRepository as \&amp;quot;:Audit Log Repository\&amp;quot;
participant Database@{ \&amp;quot;type\&amp;quot;: \&amp;quot;database\&amp;quot; } as \&amp;quot;:Database\&amp;quot;
Admin-&amp;gt;&amp;gt;UserPage: Confirm system role assignment
activate UserPage
UserPage-&amp;gt;&amp;gt;UserController: Assign system role
activate UserController
UserController-&amp;gt;&amp;gt;UserService: assignSystemRole(userId, roleId, actorId)
activate UserService
UserService-&amp;gt;&amp;gt;UserRepository: Get target user and current role
activate UserRepository
UserRepository-&amp;gt;&amp;gt;Database: Retrieve target user and current role
activate Database
Database--&amp;gt;&amp;gt;UserRepository: User and current role
deactivate Database
UserRepository--&amp;gt;&amp;gt;UserService: User and current role
deactivate UserRepository
UserService-&amp;gt;&amp;gt;RoleRepository: Get selected system role
activate RoleRepository
RoleRepository-&amp;gt;&amp;gt;Database: Retrieve selected role
activate Database
Database--&amp;gt;&amp;gt;RoleRepository: Role / Role unavailable
deactivate Database
RoleRepository--&amp;gt;&amp;gt;UserService: Role / Role unavailable
deactivate RoleRepository
UserService-&amp;gt;&amp;gt;UserService: Validate target account and selected role
alt Selected role is not available - EX-1
UserService--&amp;gt;&amp;gt;UserController: MSG09 - Invalid account information.&amp;lt;br/&amp;gt;The role does not exist
deactivate UserService
UserController--&amp;gt;&amp;gt;UserPage: Return role validation error
deactivate UserController
UserPage--&amp;gt;&amp;gt;Admin: MSG09 - Invalid account information.&amp;lt;br/&amp;gt;The role does not exist
else Selected role is available
activate UserController
activate UserService
UserService-&amp;gt;&amp;gt;UserRepository: Verify active account retains user administration permission
activate UserRepository
UserRepository-&amp;gt;&amp;gt;Database: Check active holders of user administration permission
activate Database
Database--&amp;gt;&amp;gt;UserRepository: Remaining active holder count
deactivate Database
UserRepository--&amp;gt;&amp;gt;UserService: Remaining active holder count
deactivate UserRepository
alt Assignment would remove the last active administrator - EX-2
UserService--&amp;gt;&amp;gt;UserController: MSG12 - Unable to change the status of this user account
deactivate UserService
UserController--&amp;gt;&amp;gt;UserPage: Return role assignment conflict
deactivate UserController
UserPage--&amp;gt;&amp;gt;Admin: MSG12 - Unable to change the status of this user account
else Assignment is permitted
activate UserController
activate UserService
UserService-&amp;gt;&amp;gt;UserRepository: Assign selected system role to user
activate UserRepository
UserRepository-&amp;gt;&amp;gt;Database: Save user role assignment
activate Database
Database--&amp;gt;&amp;gt;UserRepository: Role assignment saved
deactivate Database
UserRepository--&amp;gt;&amp;gt;UserService: Updated user
deactivate UserRepository
UserService-&amp;gt;&amp;gt;AuditLogRepository: Record system role assignment or change
activate AuditLogRepository
AuditLogRepository-&amp;gt;&amp;gt;Database: Insert audit record
activate Database
Database--&amp;gt;&amp;gt;AuditLogRepository: Audit record saved
deactivate Database
AuditLogRepository--&amp;gt;&amp;gt;UserService: Audit record saved
deactivate AuditLogRepository
UserService--&amp;gt;&amp;gt;UserController: User role updated successfully
deactivate UserService
UserController--&amp;gt;&amp;gt;UserPage: MSG10 - User account updated successfully
deactivate UserController
UserPage--&amp;gt;&amp;gt;Admin: MSG10 - User account updated successfully
end
end
deactivate UserPage
&amp;quot;, &amp;quot;config&amp;quot;: null}">
