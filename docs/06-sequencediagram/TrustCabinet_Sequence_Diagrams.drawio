  <diagram id="uc21_startmeeting" name="UC-21 - Start Meeting">
    <mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject id="mermaid-uc21_startmeeting" label="" mermaidData="{&amp;quot;data&amp;quot;: &amp;quot;%%{init: {\&amp;quot;sequence\&amp;quot;: {\&amp;quot;mirrorActors\&amp;quot;: false}}}%%
sequenceDiagram
actor Chair as \&amp;quot;Chair\&amp;quot;
participant MeetingPage@{ \&amp;quot;type\&amp;quot;: \&amp;quot;boundary\&amp;quot; } as \&amp;quot;Meeting Management Page\&amp;quot;
participant MeetingController@{ \&amp;quot;type\&amp;quot;: \&amp;quot;control\&amp;quot; } as \&amp;quot;:Meeting Controller\&amp;quot;
participant MeetingService@{ \&amp;quot;type\&amp;quot;: \&amp;quot;control\&amp;quot; } as \&amp;quot;:Meeting Service\&amp;quot;
participant MeetingRepository as \&amp;quot;:Meeting Repository\&amp;quot;
participant MeetingParticipantRepository as \&amp;quot;:Meeting Participant Repository\&amp;quot;
participant UserRepository as \&amp;quot;:User Repository\&amp;quot;
participant MeetingStatusHistoryRepository as \&amp;quot;:Meeting Status History Repository\&amp;quot;
participant NotificationService@{ \&amp;quot;type\&amp;quot;: \&amp;quot;control\&amp;quot; } as \&amp;quot;:Notification Service\&amp;quot;
participant Database@{ \&amp;quot;type\&amp;quot;: \&amp;quot;database\&amp;quot; } as \&amp;quot;:Database\&amp;quot;
Chair-&amp;gt;&amp;gt;MeetingPage: Start Meeting
activate MeetingPage
MeetingPage-&amp;gt;&amp;gt;MeetingController: Start Meeting
activate MeetingController
MeetingController-&amp;gt;&amp;gt;MeetingService: startMeeting(meetingId, chairId)
activate MeetingService
MeetingService-&amp;gt;&amp;gt;MeetingRepository: Get current meeting
activate MeetingRepository
MeetingRepository-&amp;gt;&amp;gt;Database: Retrieve meeting and lifecycle status
activate Database
Database--&amp;gt;&amp;gt;MeetingRepository: Meeting / Meeting not found
deactivate Database
MeetingRepository--&amp;gt;&amp;gt;MeetingService: Meeting / Meeting not found
deactivate MeetingRepository
alt Meeting cannot be started - EX-1
MeetingService--&amp;gt;&amp;gt;MeetingController: MSG112 - This meeting cannot be started
deactivate MeetingService
MeetingController--&amp;gt;&amp;gt;MeetingPage: Return meeting start failure
deactivate MeetingController
MeetingPage--&amp;gt;&amp;gt;Chair: MSG112 - This meeting cannot be started
else Meeting is Published
activate MeetingController
activate MeetingService
MeetingService-&amp;gt;&amp;gt;MeetingParticipantRepository: Verify current Chair and Secretary assignments (BR-127, BR-130)
activate MeetingParticipantRepository
MeetingParticipantRepository-&amp;gt;&amp;gt;Database: Retrieve current meeting roles
activate Database
Database--&amp;gt;&amp;gt;MeetingParticipantRepository: Current Chair and Secretary assignments
deactivate Database
MeetingParticipantRepository--&amp;gt;&amp;gt;MeetingService: Current Chair and Secretary assignments
deactivate MeetingParticipantRepository
MeetingService-&amp;gt;&amp;gt;UserRepository: Verify assigned Chair and Secretary accounts are active (BR-127)
activate UserRepository
UserRepository-&amp;gt;&amp;gt;Database: Check account status
activate Database
Database--&amp;gt;&amp;gt;UserRepository: Account eligibility
deactivate Database
UserRepository--&amp;gt;&amp;gt;MeetingService: Account eligibility
deactivate UserRepository
MeetingService-&amp;gt;&amp;gt;MeetingService: Revalidate Chair assignment, Published status,&amp;lt;br/&amp;gt;exactly one active Chair and at least one active Secretary (BR-127, BR-130, BR-131)
alt Meeting or role readiness is no longer valid - EX-1
MeetingService--&amp;gt;&amp;gt;MeetingController: MSG112 - This meeting cannot be started
deactivate MeetingService
MeetingController--&amp;gt;&amp;gt;MeetingPage: Return meeting start failure
deactivate MeetingController
MeetingPage--&amp;gt;&amp;gt;Chair: MSG112 - This meeting cannot be started
else Meeting can be started
activate MeetingController
activate MeetingService
MeetingService-&amp;gt;&amp;gt;MeetingRepository: Change Published to InProgress and record Actual Start Time (BR-131)
activate MeetingRepository
MeetingRepository-&amp;gt;&amp;gt;Database: Save meeting lifecycle transition
activate Database
alt Meeting start cannot be completed - EX-2
Database--&amp;gt;&amp;gt;MeetingRepository: Save failed
deactivate Database
MeetingRepository--&amp;gt;&amp;gt;MeetingService: Meeting start failed
deactivate MeetingRepository
MeetingService--&amp;gt;&amp;gt;MeetingController: MSG115 - Unable to start the meeting. Please try again
deactivate MeetingService
MeetingController--&amp;gt;&amp;gt;MeetingPage: Return meeting start failure
deactivate MeetingController
MeetingPage--&amp;gt;&amp;gt;Chair: MSG115 - Unable to start the meeting. Please try again
else Meeting status is InProgress
activate Database
activate MeetingController
activate MeetingRepository
activate MeetingService
Database--&amp;gt;&amp;gt;MeetingRepository: Meeting status updated
deactivate Database
MeetingRepository--&amp;gt;&amp;gt;MeetingService: Meeting status updated
deactivate MeetingRepository
MeetingService-&amp;gt;&amp;gt;MeetingStatusHistoryRepository: Record start action, actor, timestamp, and status (BR-38)
activate MeetingStatusHistoryRepository
MeetingStatusHistoryRepository-&amp;gt;&amp;gt;Database: Insert lifecycle history
activate Database
Database--&amp;gt;&amp;gt;MeetingStatusHistoryRepository: History recorded
deactivate Database
MeetingStatusHistoryRepository--&amp;gt;&amp;gt;MeetingService: History recorded
deactivate MeetingStatusHistoryRepository
MeetingService-&amp;gt;&amp;gt;NotificationService: Notify current invited internal participants&amp;lt;br/&amp;gt;that the Meeting has started (BR-164)
activate NotificationService
activate NotificationService
NotificationService--&amp;gt;&amp;gt;MeetingService: Notifications created / delivery failed&amp;lt;br/&amp;gt;(failure does not undo the start)
deactivate NotificationService
MeetingService--&amp;gt;&amp;gt;MeetingController: Meeting started successfully
deactivate MeetingService
MeetingController--&amp;gt;&amp;gt;MeetingPage: MSG110 - Meeting started successfully
deactivate MeetingController
MeetingPage--&amp;gt;&amp;gt;Chair: MSG110 - Meeting started successfully
deactivate NotificationService
end
end
end
deactivate MeetingPage
