  <diagram id="uc12a_createrole" name="UC-12a - Create Role">
    <mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject id="mermaid-uc12a_createrole" label="" mermaidData="{&amp;quot;data&amp;quot;: &amp;quot;%%{init: {\&amp;quot;sequence\&amp;quot;: {\&amp;quot;mirrorActors\&amp;quot;: false}}}%%
sequenceDiagram
actor Admin as \&amp;quot;System Admin\&amp;quot;
participant RolePage@{ \&amp;quot;type\&amp;quot;: \&amp;quot;boundary\&amp;quot; } as \&amp;quot;Role &amp;amp; Permission Management Page\&amp;quot;
participant RoleController@{ \&amp;quot;type\&amp;quot;: \&amp;quot;control\&amp;quot; } as \&amp;quot;:Role Controller\&amp;quot;
participant RoleService@{ \&amp;quot;type\&amp;quot;: \&amp;quot;control\&amp;quot; } as \&amp;quot;:Role Service\&amp;quot;
participant RoleRepository as \&amp;quot;:Role Repository\&amp;quot;
participant AuditService@{ \&amp;quot;type\&amp;quot;: \&amp;quot;control\&amp;quot; } as \&amp;quot;:Audit Service\&amp;quot;
participant Database@{ \&amp;quot;type\&amp;quot;: \&amp;quot;database\&amp;quot; } as \&amp;quot;:Database\&amp;quot;
Admin-&amp;gt;&amp;gt;RolePage: Submit new role (name, description, permissions)
activate RolePage
RolePage-&amp;gt;&amp;gt;RoleController: Create role
activate RoleController
RoleController-&amp;gt;&amp;gt;RoleService: Create role
activate RoleService
RoleService-&amp;gt;&amp;gt;RoleService: Validate role information
alt Invalid role information
RoleService--&amp;gt;&amp;gt;RoleController: Invalid role information
RoleController--&amp;gt;&amp;gt;RolePage: MSG20 - Invalid role information
RolePage--&amp;gt;&amp;gt;Admin: Show validation errors
else Valid role information
RoleService-&amp;gt;&amp;gt;RoleRepository: Check whether role name exists
activate RoleRepository
RoleRepository-&amp;gt;&amp;gt;Database: Find role by name (case-insensitive)
activate Database
Database--&amp;gt;&amp;gt;RoleRepository: Search result
RoleRepository--&amp;gt;&amp;gt;RoleService: Role name exists / available
alt Role name already exists
RoleService--&amp;gt;&amp;gt;RoleController: Duplicate role name
RoleController--&amp;gt;&amp;gt;RolePage: MSG21 - Role name already exists
RolePage--&amp;gt;&amp;gt;Admin: Show duplicate name error
else Role name is available
RoleService-&amp;gt;&amp;gt;RoleRepository: Save new role and its permissions
RoleRepository-&amp;gt;&amp;gt;Database: Insert role and role permissions
Database--&amp;gt;&amp;gt;RoleRepository: Insert result
RoleRepository--&amp;gt;&amp;gt;RoleService: Save result
alt Role cannot be saved
RoleService--&amp;gt;&amp;gt;RoleController: Unable to create role
RoleController--&amp;gt;&amp;gt;RolePage: Error - Unable to create role
RolePage--&amp;gt;&amp;gt;Admin: Show error message
else Role saved
RoleService-&amp;gt;&amp;gt;AuditService: Record role creation
activate AuditService
AuditService-&amp;gt;&amp;gt;Database: Save audit log
Database--&amp;gt;&amp;gt;AuditService: Audit log saved
AuditService--&amp;gt;&amp;gt;RoleService: Audit recorded
RoleService--&amp;gt;&amp;gt;RoleController: Role created successfully
RoleController--&amp;gt;&amp;gt;RolePage: MSG19 - Role created successfully
RolePage--&amp;gt;&amp;gt;Admin: Show success message and updated role list
deactivate AuditService
end
end
deactivate Database
deactivate RoleRepository
end
deactivate RoleService
deactivate RoleController
deactivate RolePage
&amp;quot;, &amp;quot;config&amp;quot;: null}">
