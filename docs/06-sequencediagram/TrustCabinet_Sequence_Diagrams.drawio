  <diagram id="uc06b_updateuseraccount" name="UC-06b - Update User Account">
    <mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject id="mermaid-uc06b_updateuseraccount" label="" mermaidData="{&amp;quot;data&amp;quot;: &amp;quot;%%{init: {\&amp;quot;sequence\&amp;quot;: {\&amp;quot;mirrorActors\&amp;quot;: false}}}%%
sequenceDiagram
actor Admin as \&amp;quot;System Admin / Workspace Manager\&amp;quot;
participant UserPage@{ \&amp;quot;type\&amp;quot;: \&amp;quot;boundary\&amp;quot; } as \&amp;quot;User Management Page\&amp;quot;
participant UserController@{ \&amp;quot;type\&amp;quot;: \&amp;quot;control\&amp;quot; } as \&amp;quot;:User Controller\&amp;quot;
participant UserService@{ \&amp;quot;type\&amp;quot;: \&amp;quot;control\&amp;quot; } as \&amp;quot;:User Service\&amp;quot;
participant UserRepository as \&amp;quot;:User Repository\&amp;quot;
participant AuditService@{ \&amp;quot;type\&amp;quot;: \&amp;quot;control\&amp;quot; } as \&amp;quot;:Audit Service\&amp;quot;
participant Database@{ \&amp;quot;type\&amp;quot;: \&amp;quot;database\&amp;quot; } as \&amp;quot;:Database\&amp;quot;
Admin-&amp;gt;&amp;gt;UserPage: Select Edit Account
activate UserPage
UserPage-&amp;gt;&amp;gt;UserController: Request user account information
activate UserController
UserController-&amp;gt;&amp;gt;UserService: Get user account information
activate UserService
UserService-&amp;gt;&amp;gt;UserRepository: Find user account
activate UserRepository
UserRepository-&amp;gt;&amp;gt;Database: Retrieve user account
activate Database
Database--&amp;gt;&amp;gt;UserRepository: User account information
UserRepository--&amp;gt;&amp;gt;UserService: User account information
UserService--&amp;gt;&amp;gt;UserController: Current user account information
UserController--&amp;gt;&amp;gt;UserPage: Display Edit User form
UserPage--&amp;gt;&amp;gt;Admin: Show current user information
Admin-&amp;gt;&amp;gt;UserPage: Submit updated user information
UserPage-&amp;gt;&amp;gt;UserController: Update user account
UserController-&amp;gt;&amp;gt;UserService: Update user account
alt Invalid user information
UserService--&amp;gt;&amp;gt;UserController: Invalid user information
UserController--&amp;gt;&amp;gt;UserPage: Validation errors
UserPage--&amp;gt;&amp;gt;Admin: Display invalid fields
else User information is valid
UserService-&amp;gt;&amp;gt;UserRepository: Update user account information
UserRepository-&amp;gt;&amp;gt;Database: Store updated user information
Database--&amp;gt;&amp;gt;UserRepository: User account updated
UserRepository--&amp;gt;&amp;gt;UserService: Updated user account
UserService-&amp;gt;&amp;gt;AuditService: Record user account update
activate AuditService
AuditService-&amp;gt;&amp;gt;Database: Store audit record
Database--&amp;gt;&amp;gt;AuditService: Audit record created
AuditService--&amp;gt;&amp;gt;UserService: Update recorded
UserService--&amp;gt;&amp;gt;UserController: User account updated successfully
UserController--&amp;gt;&amp;gt;UserPage: MSG10 - User account updated successfully
UserPage--&amp;gt;&amp;gt;Admin: Return to User Accounts list
deactivate AuditService
end
deactivate Database
deactivate UserRepository
deactivate UserService
deactivate UserController
deactivate UserPage
&amp;quot;, &amp;quot;config&amp;quot;: null}">
