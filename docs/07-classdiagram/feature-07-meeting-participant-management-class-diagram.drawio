<mxCell id="subtitle" value="Layer colors and UML stereotypes synchronized with existing class diagrams" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="2040" height="28" as="geometry"/></mxCell>
<mxCell id="boundary" value="&lt;div style=&quot;text-align:center&quot;&gt;&amp;lt;&amp;lt;boundary&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;MeetingManagementPage&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;+ viewParticipants(meetingId)&lt;br&gt;+ add / changeRole / remove participant&lt;br&gt;+ respondToInvitation(response)&lt;br&gt;+ viewResponseStatus(meetingId)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=top;spacingTop=8;spacingLeft=6;spacingRight=6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="88.25" y="130" width="273.5" height="153" as="geometry"/></mxCell>
<mxCell id="controller" value="&lt;div style=&quot;text-align:center&quot;&gt;&amp;lt;&amp;lt;control&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;MeetingParticipantController&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;+ getParticipants(meetingId)&lt;br&gt;+ addParticipant(input)&lt;br&gt;+ changeRole(participantId, role)&lt;br&gt;+ removeParticipant(participantId)&lt;br&gt;+ respondToInvitation(response)&lt;br&gt;+ getResponseStatus(meetingId)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=top;spacingTop=8;spacingLeft=6;spacingRight=6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="594.5" y="130" width="241" height="189" as="geometry"/></mxCell>
