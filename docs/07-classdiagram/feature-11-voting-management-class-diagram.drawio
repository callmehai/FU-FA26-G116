<mxCell id="title" value="FE-11 · Voting Management — Class Diagram" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="3233" height="38" as="geometry" /></mxCell><mxCell id="page" value="&lt;div style=&quot;text-align:center&quot;&gt;&amp;lt;&amp;lt;boundary&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;MeetingManagementPage&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;width:100%;height:0;border:0;border-top:1px solid #000000;margin:6px 0;&quot;&gt;&lt;div style=&quot;text-align:left&quot;&gt;+ viewMeetingVotes(meetingId)&lt;br&gt;+ viewVoteStatus(voteId)&lt;br&gt;+ saveVoteDraft(meetingId, voteId?, voteInfo)&lt;br&gt;+ deleteVoteDraft(voteId)&lt;br&gt;+ openVote(meetingId, voteId?, voteInfo)&lt;br&gt;+ castVote(voteId, optionId)&lt;br&gt;+ closeVote(voteId)&lt;br&gt;+ recordVoteConclusion(voteId, conclusion, note)&lt;br&gt;+ attachVoteDocuments(voteId, source, documents)&lt;br&gt;+ detachVoteDocument(voteId, meetingDocumentId)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;verticalAlign=top;spacingTop=8;spacingLeft=6;spacingRight=6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="377" height="284" as="geometry" /></mxCell><mxCell id="controller" value="&lt;div style=&quot;text-align:center&quot;&gt;&amp;lt;&amp;lt;control&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;VoteController&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;width:100%;height:0;border:0;border-top:1px solid #000000;margin:6px 0;&quot;&gt;&lt;div style=&quot;text-align:left&quot;&gt;+ listMeetingVotes(meetingId)&lt;br&gt;+ getVoteStatus(meetingId, voteId)&lt;br&gt;+ manageVoteDraft(meetingId, voteId?, operation, voteInfo)&lt;br&gt;+ openVote(meetingId, voteId?, voteInfo)&lt;br&gt;+ castVote(meetingId, voteId, optionId)&lt;br&gt;+ closeVote(meetingId, voteId)&lt;br&gt;+ recordVoteConclusion(meetingId, voteId, conclusion, note)&lt;br&gt;+ attachVoteDocuments(