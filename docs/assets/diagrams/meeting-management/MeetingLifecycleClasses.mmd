classDiagram
    direction LR

    class Meeting {
        +Guid Id
        +string Title
        +MeetingStatus Status
        +Guid CreatedById
        +Guid? AssignedApproverId
        +DateTimeOffset StartsAt
        +DateTimeOffset? EndsAt
    }
    class MeetingStatusHistory {
        +Guid Id
        +MeetingHistoryAction Action
        +MeetingStatus? FromStatus
        +MeetingStatus ToStatus
        +Guid ActorId
        +Guid? AssignedApproverId
        +string Reason
        +DateTimeOffset OccurredAt
    }
    class MeetingParticipant {
        +Guid MeetingId
        +Guid UserId
        +MeetingRole Role
        +InvitationResponse Response
        +Guid? DelegatedToUserId
    }
    class User {
        +Guid Id
        +string FullName
        +bool IsActive
        +Guid RoleId
    }
    class Role {
        +Guid Id
        +string Name
    }
    class RoleCapability {
        +Guid RoleId
        +Capability Capability
    }
    class Notification {
        +Guid UserId
        +NotificationType Type
        +Guid? MeetingId
        +Guid? OriginHistoryId
    }
    class EmailMessage {
        +string DeduplicationKey
        +string Subject
        +string Body
        +string? CalendarAttachment
        +EmailStatus Status
        +DateTimeOffset? SentAt
        +Guid? MeetingId
        +Guid? OriginHistoryId
        +Guid? RecipientUserId
        +EmailMessageType? MessageType
        +string? PayloadSnapshot
    }
    class MeetingStatus {
        <<enumeration>>
        Draft
        WaitingApproval
        Rejected
        Approved
        Published
        InProgress
        Ended
        MinutesIssued
        Archived
    }
    class MeetingHistoryAction {
        <<enumeration>>
        Create
        SubmitForApproval
        Approve
        Reject
        ReturnToDraft
        Publish
        LegacyTransition
    }
    class MeetingRole {
        <<enumeration>>
        Chair
        Secretary
        Member
        Guest
    }
    class InvitationResponse {
        <<enumeration>>
        Pending
        Accepted
        Declined
        Delegated
    }
    class Capability {
        <<enumeration>>
        MeetingCreator
        MeetingApprover
    }
    class EmailStatus {
        <<enumeration>>
        Queued
        Processing
        Sent
        Failed
    }

    User "1" <-- "0..*" Meeting : CreatedBy
    User "0..1" <-- "0..*" Meeting : AssignedApprover
    Meeting "1" -- "0..*" MeetingStatusHistory : lịch sử chỉ ghi thêm
    User "1" <-- "0..*" MeetingStatusHistory : Actor
    User "0..1" <-- "0..*" MeetingStatusHistory : approver snapshot
    Meeting "1" *-- "0..*" MeetingParticipant : thành phần tham dự
    User "1" <-- "0..*" MeetingParticipant : người tham dự
    User "1" <-- "0..*" Notification : người nhận
    Meeting "0..1" <-- "0..*" Notification : cuộc họp liên quan
    MeetingStatusHistory "0..1" <-- "0..*" Notification : nguồn sự kiện
    User "0..1" <-- "0..*" EmailMessage : recipient snapshot
    Meeting "0..1" <-- "0..*" EmailMessage : thư mời cuộc họp
    MeetingStatusHistory "0..1" <-- "0..*" EmailMessage : nguồn sự kiện
    Role "1" <-- "0..*" User : vai trò hiện tại
    Role "1" *-- "0..*" RoleCapability : quyền được cấp

    note for MeetingStatusHistory "Bằng chứng kiểm toán: chỉ INSERT, chặn UPDATE và DELETE."
    note for MeetingParticipant "Publish chọn user active có Response khác Delegated."
    note for EmailMessage "Producer SCRUM-15 lưu Body/.ics từ snapshot Publish; worker gửi giá trị đã lưu. PayloadSnapshot chỉ dành cho dữ liệu cũ."
