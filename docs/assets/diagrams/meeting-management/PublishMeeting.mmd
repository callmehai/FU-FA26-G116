sequenceDiagram
    title UC-17 - Publish Meeting
    actor Organizer as Meeting Organizer
    participant Page as Meeting Management Page
    participant API as Meeting API
    participant Service as Meeting Service
    participant DB as Database
    participant Worker as SCRUM-15 Email Worker
    participant Email as Email Service

    Organizer->>Page: Select Publish
    Page->>API: POST /api/meetings/{id}/transitions, action=Publish
    API->>Service: Publish(meetingId, authenticated actor)
    Service->>DB: BEGIN and lock meeting row
    DB-->>Service: Current owner and status
    Service->>DB: Check Organizer is active with MeetingCreator
    DB-->>Service: Current authorization result

    alt Meeting is missing or caller cannot read it
        Service->>DB: ROLLBACK without writes
        Service-->>API: 404 Not Found
        API-->>Page: Display meeting unavailable
    else Meeting is visible to caller
      alt Caller is not the active Organizer with MeetingCreator
        Service->>DB: ROLLBACK without writes
        Service-->>API: 403 MEETING_ACTION_FORBIDDEN
        API-->>Page: Display publication access denied
      else Caller is the authorized Organizer
        alt Meeting is no longer Approved
            Service->>DB: ROLLBACK without writes
            Service-->>API: 409 MEETING_STATUS_CONFLICT
            API-->>Page: Refresh current meeting status
        else Meeting is Approved
            Service->>DB: Read participant rows and current user status
            DB-->>Service: Participant and active-account data
            Service->>Service: Snapshot active participants where Response != Delegated
            Note over Service: DelegatedToUserId alone does not add a recipient. Later participant changes cannot alter this batch.
            Service->>DB: UPDATE status to Published
            Service->>DB: INSERT Publish history and participant notifications
            Service->>DB: INSERT invitation jobs with recipient/content snapshot
            Note over DB: Each EmailMessage is Queued with SentAt = null.
            alt SaveChanges fails
                DB-->>Service: Persistence error
                Service->>DB: ROLLBACK status, history, notifications, and email jobs
                Service-->>API: 503 MEETING_WORKFLOW_FAILED
                API-->>Page: Show retryable publication error
            else All writes are staged in the transaction
                DB-->>Service: Pending status, history, notification, and email rows
                Service->>DB: COMMIT
                alt Commit fails
                    DB-->>Service: Commit error
                    Service->>DB: ROLLBACK the whole transaction
                    Service-->>API: 503 MEETING_WORKFLOW_FAILED
                    API-->>Page: Show retryable publication error
                else Commit succeeds
                DB-->>Service: Published status, history, snapshot, and jobs committed
                Service-->>API: Published, invitation jobs queued
                API-->>Page: 200 MEETING_TRANSITION_COMPLETED
                Page-->>Organizer: Show publication confirmation

                opt After commit, SCRUM-15 processes queued email jobs
                    Worker->>DB: Read queued job and stored snapshot
                    DB-->>Worker: Recipient and immutable invitation payload
                    Worker->>Email: Send invitation
                    alt Delivery succeeds
                        Email-->>Worker: Accepted for delivery
                        Worker->>DB: Set EmailStatus=Sent and SentAt
                    else Delivery keeps failing after retries
                        Email-->>Worker: Delivery failed
                        Worker->>DB: Set EmailStatus=Failed and retain error
                    end
                    Note over Worker,DB: Delivery outcome never rolls Published back.
                end
                end
            end
        end
      end
    end
