        <mxCell id="e-initial-planning" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#1E4FA3;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="initial" target="planning">
