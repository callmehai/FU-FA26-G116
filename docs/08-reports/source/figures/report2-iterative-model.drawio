<mxfile host="drawio">
  <diagram id="iterative-model" name="Iterative Incremental Model">
    <mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1020" pageHeight="460" math="0" shadow="0" background="#FFFFFF">
      <root>
