        <mxCell id="initial" value="Initial planning" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#1E4FA3;strokeWidth=2;dashed=1;fontSize=15;fontFamily=Times New Roman;" vertex="1" parent="1">
