    {
      "name": "2. Cuộc họp: tạo, duyệt, công bố, huỷ",
      "item": [
        {
          "name": "API08 — Danh sách cuộc họp",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('có items và totalCount', () => { const b = pm.response.json(); pm.expect(b.items).to.be.an('array'); pm.expect(b.totalCount).to.be.a('number'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/meetings?page=1&pageSize=10"
          }
        },
        {
          "name": "API09 — Tạo cuộc họp thiếu tiêu đề → MSG31",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = new Date(Date.now() + 24 * 3600 * 1000); d.setUTCHours(2, 0, 0, 0);",
                  "pm.collectionVariables.set('startAt', d.toISOString().replace('.000Z', 'Z'));",
                  "pm.collectionVariables.set('endAt', new Date(d.getTime() + 3600 * 1000).toISOString().replace('.000Z', 'Z'));",
                  "pm.collectionVariables.set('stamp', new Date().toISOString().slice(0, 19).replace('T', ' '));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
                  "pm.test('code = MSG31', () => pm.expect(pm.response.json().code).to.eql('MSG31'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/meetings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"\",\n  \"plannedStartTime\": \"{{startAt}}\",\n  \"plannedEndTime\": \"{{endAt}}\",\n  \"mode\": \"InPerson\",\n  \"location\": \"Phòng họp Postman\",\n  \"sensitivity\": \"Normal\",\n  \"description\": \"Cuộc họp do collection Postman tạo để kiểm thử API.\",\n  \"participants\": [\n    {\n      \"userId\": \"{{approverId}}\",\n      \"role\": \"Chair\"\n    },\n    {\n      \"userId\": \"{{secretaryId}}\",\n      \"role\": \"Secretary\"\n    },\n    {\n      \"userId\": \"{{organizerId}}\",\n      \"role\": \"Member\"\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "API10 — Tạo cuộc họp",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = new Date(Date.now() + 24 * 3600 * 1000); d.setUTCHours(2, 0, 0, 0);",
                  "pm.collectionVariables.set('startAt', d.toISOString().replace('.000Z', 'Z'));",
                  "pm.collectionVariables.set('endAt', new Date(d.getTime() + 3600 * 1000).toISOString().replace('.000Z', 'Z'));",
                  "pm.collectionVariables.set('stamp', new Date().toISOString().slice(0, 19).replace('T', ' '));"
                ]
