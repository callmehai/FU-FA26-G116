{
  "info": {
    "name": "TrustCabinet API — luồng chính",
    "description": "Luồng chính của TrustCabinet: đăng nhập, cuộc họp (tạo, duyệt, công bố, huỷ), chương trình nghị sự, thành phần, tài liệu, điểm danh, biểu quyết, thông báo. Chạy tuần tự trên app local đã seed, cùng môi trường TrustCabinet-local. Xem tests/postman/README.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Xác thực (UC-01)",
      "item": [
        {
          "name": "API01 — Sai mật khẩu → MSG01",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
                  "pm.test('code = MSG01', () => pm.expect(pm.response.json().code).to.eql('MSG01'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{organizerEmail}}\",\n  \"password\": \"sai-mat-khau\"\n}"
            }
          }
        },
        {
          "name": "API02 — Đăng nhập Thành viên (người tổ chức, lưu token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('trả accessToken và user', () => { pm.expect(b.accessToken).to.be.a('string'); pm.expect(b.user.id).to.be.a('string'); });",
                  "pm.environment.set('token', b.accessToken);",
                  "pm.collectionVariables.set('organizerId', b.user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{organizerEmail}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          }
        },
