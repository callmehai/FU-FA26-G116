                  "pm.test('cấp accessToken mới', () => pm.expect(b.accessToken).to.be.a('string'));",
                  "pm.environment.set('token', b.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/auth/refresh"
          }
        },
