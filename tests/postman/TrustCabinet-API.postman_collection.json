                  "const b = pm.response.json();",
                  "pm.test('trạng thái Draft', () => pm.expect(b.meeting.status).to.eql('Draft'));",
                  "pm.collectionVariables.set('meetingId', b.meeting.id);"
                ]
              }
            }
