# Chép thành deploy/.env trên server rồi điền giá trị thật. File .env đã bị gitignore — đừng commit.

# Tên miền của server. Chưa có tên miền thì dùng sslip.io: IP 13.250.1.2 → 13-250-1-2.sslip.io
SITE_ADDRESS=13-250-1-2.sslip.io

# Sinh bằng: openssl rand -hex 24   (chỉ chữ và số, để không phải escape trong connection string)
POSTGRES_PASSWORD=

# Sinh bằng: openssl rand -hex 32   (ít nhất 32 ký tự)
SIGNING_KEY=

# Phòng họp (LiveKit). Sinh bằng: openssl rand -hex 32   (ít nhất 32 ký tự)
# Workflow deploy tự thêm dòng này vào deploy/.env trên server nếu chưa có.
LIVEKIT_API_SECRET=

# Tuỳ chọn — kho tệp tài liệu trên Cloudflare R2 (ADR-0024). Thiếu thì tải tài liệu trả MSG166.
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com ; access key chỉ có quyền Object Read & Write trên đúng bucket.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Tuỳ chọn — gửi email thật. Gmail: smtp.gmail.com, cổng 587, mật khẩu là App Password.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Tuỳ chọn — máy chuyển chữ (chuyển bản ghi thành chữ, Voice ID, ghi theo micro từng người). Cần máy
# 4 GB RAM; bật trên máy 1 GB thì server hết RAM. Bật bằng cách bỏ dấu # ở hai dòng dưới, xem README §10.
# COMPOSE_PROFILES=speech
# SPEECH_URL=http://speech:8090
