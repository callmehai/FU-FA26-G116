{
  "scope": "app",
  "allow": {
    "C1": { "selector": ".sidebar, .room-header, .login-screen", "reason": "ADR-0012: blue gradient sidebar; the room header and login band follow it" },
    "T3": { "selector": "th, th *", "reason": "ADR-0012: uppercase 12px column headings" },
    "L3": { "selector": ".level, .level *", "reason": "ADR-0012, ADR-0028: each sensitivity level has its own icon" },
    "S2": { "selector": "[class^='prejoin'], [class*=' prejoin'], [class^='room-'], [class*=' room-']", "reason": "Call room follows Google Meet (SCRUM-39..44)" }
  }
}
